// S7: Three-actor orchestrator example for `garnet trust-report`.
//
// `garnet run` executes these actors in-process in the interpreter, with
// bounded mailboxes (capacity 1024). No OS thread is spawned per actor: the
// threaded runtime in `garnet-actor-runtime` is a staging crate that nothing
// in the workspace links (ADR 0015). The file keeps its S7 name.
//
// Dogfood:
//   garnet run examples/agent_orchestrator_3thread.garnet
//   garnet trust-report examples/agent_orchestrator_3thread.garnet \
//     | grep -q "actors: 3 / threads: 3"
//
// Scope:
// - The `trust-report` count is STRUCTURAL — it counts `actor` declarations
//   in the parsed source. It does NOT instrument the runtime to record a
//   live thread spawn count. Its "threads" figure restates the staging
//   crate's one-thread-per-actor design, not what `garnet run` does.
// - The actors here use simple synchronous patterns so the example can
//   `garnet run` to completion under the managed-mode interpreter.

@caps()
def main() {
  println("agent_orchestrator_3thread: structural example for S7 trust-report")
  println("actors: Researcher, Synthesizer, Reviewer")
  println("actors run in-process in the interpreter; no OS thread per actor")
  3
}

actor Researcher {
  let mut runs = 0

  on inspect() {
    runs += 1
    runs
  }
}

actor Synthesizer {
  let mut drafts = 0

  on compose() {
    drafts += 1
    drafts
  }
}

actor Reviewer {
  let mut verdicts = 0

  on review() {
    verdicts += 1
    verdicts
  }
}
