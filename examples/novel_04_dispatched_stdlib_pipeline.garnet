# novel_04_dispatched_stdlib_pipeline.garnet
#
# S21 PROOF: the S17 Layer-0/1 stdlib primitives now EXECUTE from Garnet source
# via qualified dispatch — not just declared in the registry. This single
# program drives FOUR newly-dispatched modules end-to-end through `garnet run`:
#   - core::iter  (higher-order filter / map / fold with FIRST-CLASS functions)
#   - core::math  (sqrt / abs / round, dispatching garnet_stdlib::math)
#   - core::cmp   (clamp into a budget)
#   - std::base64 (content-address the result, dispatching garnet_stdlib::base64)
#
# Deterministic, so the output is reproducible byte-for-byte.

def square(x) { x * x }
def is_positive(x) { x > 0 }
def add(acc, x) { acc + x }

@caps()
def main() {
  let raw = [1, -2, 3, -4, 5]

  # higher-order iterator combinators, callable from managed Garnet (S21):
  let positives = core::iter::filter(raw, is_positive)   # [1, 3, 5]
  let squares = core::iter::map(positives, square)        # [1, 9, 25]
  let sum = core::iter::fold(squares, 0, add)             # 35

  # core::math on the aggregate (dispatches the stdlib host fns):
  let magnitude = core::math::sqrt(core::math::abs(sum))  # sqrt(35) ≈ 5.916
  let rounded = core::math::round(magnitude)              # 6

  # core::cmp clamps the score into a [0, 5] budget:
  let score = core::cmp::clamp(rounded, 0.0, 5.0)         # 6 -> 5

  # std::base64 content-addresses the verdict:
  let tag = std::base64::encode("score=5")

  println("novel_04 sum:", sum)
  println("novel_04 score:", score)
  println("novel_04 tag:", tag)
  sum
}
