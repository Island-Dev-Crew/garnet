## eval.rs require_capability active frame bypass
   666	/// Enforce that a host-authority primitive's required capability was declared in
   667	/// the calling chain. S91 adds a program-entry frame for `garnet run --interp`
   668	/// so safe-mode entry points are covered too. Outside any program frame (e.g. a
   669	/// direct host/test call) there is no `@caps` context to enforce, so the call is
   670	/// allowed.
   671	pub(crate) fn require_capability(needed: &str, fn_name: &str) -> Result<(), RuntimeError> {
   672	    ACTIVE_CAPS.with(|c| {
   673	        let c = c.borrow();
   674	        if c.active_frames == 0 {
   675	            return Ok(());
   676	        }
   677	        let has = |k: &str| c.counts.get(k).copied().unwrap_or(0) > 0;
   678	        if has("*") || has(needed) {
   679	            Ok(())
   680	        } else {
   681	            Err(RuntimeError::msg(format!(
   682	                "capability: `{fn_name}` requires @caps({needed}), not declared in the calling chain"
   683	            )))
   684	        }
   685	    })
   686	}
