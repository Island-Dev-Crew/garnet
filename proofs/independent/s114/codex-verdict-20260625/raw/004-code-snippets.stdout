## capability_surface.rs collect_cap_fns
    28	/// functions, **impl-block methods**, and functions in nested modules — as
    29	/// `(display_name, &FnDef)`. S114 closed a hole where impl-method `@caps` was
    30	/// enforced at runtime (the interpreter installs the guard for any managed `FnDef`)
    31	/// but invisible here, so a file-/net-reading impl method reported an empty surface
    32	/// and slipped past `diff-caps`, the seal manifest, and the agent-loop gate.
    33	fn collect_cap_fns<'a>(items: &'a [Item], out: &mut Vec<(String, &'a FnDef)>) {
    34	    for item in items {
    35	        match item {
    36	            Item::Fn(f) => out.push((f.name.clone(), f)),
    37	            Item::Impl(block) => {
    38	                let owner = type_label(&block.target);
    39	                for m in &block.methods {
    40	                    out.push((format!("{owner}::{}", m.name), m));
    41	                }
    42	            }
    43	            Item::Module(m) => collect_cap_fns(&m.items, out),
    44	            _ => {}
    45	        }
    46	    }
    47	}
