    82	    /// Register a parsed module into the global environment.
    83	    pub fn load_module(&mut self, module: Module) -> Result<(), RuntimeError> {
    84	        for item in module.items {
    85	            self.register_item(item)?;
    86	        }
    87	        Ok(())
    88	    }
