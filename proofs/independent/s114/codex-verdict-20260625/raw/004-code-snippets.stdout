    90	    fn register_item(&mut self, item: Item) -> Result<(), RuntimeError> {
    91	        match item {
    92	            Item::Fn(fn_def) => {
    93	                let name = fn_def.name.clone();
    94	                let closure = Value::Fn(Rc::new(value::FnValue {
    95	                    def: fn_def,
    96	                    captured: Rc::clone(&self.global),
    97	                    is_block: false,
    98	                }));
    99	                self.global.define(&name, closure);
   100	            }
   101	            Item::Let(decl) => {
   102	                let val = eval::eval_expr(&decl.value, &self.global)?;
   103	                self.global.define(&decl.name, val);
   104	            }
   105	            Item::Const(decl) => {
   106	                let val = eval::eval_expr(&decl.value, &self.global)?;
   107	                self.global.define(&decl.name, val);
   108	            }
