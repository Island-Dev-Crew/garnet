  1134	fn init_actor_env(actor: &ActorDef, env: &Rc<Env>) -> Result<Rc<Env>, RuntimeError> {
  1135	    let actor_env = Env::new_child(env);
  1136	    for item in &actor.items {
  1137	        match item {
  1138	            ActorItem::Let(decl) => {
  1139	                let value = eval_expr(&decl.value, &actor_env)?;
  1140	                actor_env.define(&decl.name, value);
  1141	            }
  1142	            ActorItem::Memory(decl) => {
  1143	                actor_env.define(
  1144	                    &decl.name,
  1145	                    Value::MemoryStore {
  1146	                        kind: decl.kind,
  1147	                        name: decl.name.clone(),
  1148	                        backend: MemoryBackend::for_kind(decl.kind),
  1149	                    },
  1150	                );
  1151	            }
  1152	            ActorItem::Protocol(_) | ActorItem::Handler(_) => {}
  1153	        }
  1154	    }
