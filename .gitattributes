/.gitattributes text eol=lf
*.sh text eol=lf

# U-25: parsed/product text is canonical LF. Byte-exact evidence keeps the
# later -text overrides and is deliberately outside this policy.
.dogfood/windows-audit-goal.json text eol=lf
.dogfood/windows-core-audit.json text eol=lf
D_Executive_and_Presentation/garnet-website.html text eol=lf
ops/**/state-of-the-union.html text eol=lf

# Proof bundles carry MANIFEST.sha256 byte hashes; keep evidence text stable on
# Windows checkouts so local proof gates hash the same content as CI.
proofs/**/*.json text eol=lf
proofs/**/*.md text eol=lf
proofs/**/*.txt text eol=lf
proofs/**/MANIFEST.sha256 text eol=lf
# Seal source-hash determinism (S82 / WIN-S38-001): pin Garnet source to LF so a
# Windows (core.autocrlf) checkout produces the same seal predicate as Mac/Linux.
# The manifest source hash is also LF-normalized in code as defense-in-depth.
*.garnet text eol=lf

# The deterministic build manifest hashes this file through include_str!. Pin
# its compiled bytes to canonical LF on every checkout; otherwise one seal can
# become valid only for the checkout convention that produced its binary.
garnet-interp-v0.3/src/prelude.rs text eol=lf

# Keep the one Shelf package's human-readable attestation outputs canonical as
# well. The loader remains tolerant of CRLF copies, but the reviewed tree is LF.
examples/minimum-shelf-flagship/SHELF_PACKAGE.json text eol=lf
examples/minimum-shelf-flagship/tool.seal.json text eol=lf

# Proof bundles are byte-exact evidence — never normalize line endings (cross-OS seal integrity).
proofs/** -text

# ARCHIPELAGO lane evidence is byte-exact wherever it lives. Keep this after
# any text rules so the last matching pattern prevents checkout conversion.
ops/**/evidence -text
ops/**/evidence/** -text
