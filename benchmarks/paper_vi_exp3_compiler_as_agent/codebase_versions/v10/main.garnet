# v10: final snapshot for the harness-only v0.7 seed.
@caps()
def inputs_are_ready() {
  true
}

def sum_pair(left, right) {
  left + right
}

def combine(a, b, c, d) {
  let left = sum_pair(a, b)
  let right = sum_pair(c, d)
  if inputs_are_ready() {
    left + right
  } else {
    0
  }
}

@caps()
def main() {
  combine(1, 2, 3, 4)
}
