{
  "schema": "garnet.required-context-producers/v1",
  "target_branch": "main",
  "optional_contexts": ["Base-controlled trust policy"],
  "producers": [
    {"context":"Analyze (rust)","workflow":".github/workflows/codeql.yml","event":"pull_request","job":"analyze"},
    {"context":"Build VSIX (macos-latest)","workflow":".github/workflows/vscode-extension.yml","event":"pull_request","job":"build-vsix","matrix":{"os":"macos-latest"}},
    {"context":"Build VSIX (ubuntu-latest)","workflow":".github/workflows/vscode-extension.yml","event":"pull_request","job":"build-vsix","matrix":{"os":"ubuntu-latest"}},
    {"context":"Cross-OS determinism comparison","workflow":".github/workflows/determinism.yml","event":"pull_request","job":"compare"},
    {"context":"CycloneDX SBOM","workflow":".github/workflows/security.yml","event":"pull_request","job":"sbom"},
    {"context":"Deterministic build on macos-latest","workflow":".github/workflows/determinism.yml","event":"pull_request","job":"build","matrix":{"os":"macos-latest"}},
    {"context":"Deterministic build on ubuntu-latest","workflow":".github/workflows/determinism.yml","event":"pull_request","job":"build","matrix":{"os":"ubuntu-latest"}},
    {"context":"Generate single signing key for cross-OS build","workflow":".github/workflows/determinism.yml","event":"pull_request","job":"prepare-key"},
    {"context":"Garnet web PWA smoke","workflow":".github/workflows/web-pwa-readiness.yml","event":"pull_request","job":"web-pwa-readiness"},
    {"context":"PR dogfood evidence","workflow":".github/workflows/dogfood-readiness.yml","event":"pull_request","job":"pr-evidence"},
    {"context":"Windows Studio build + test","workflow":".github/workflows/macos-studio.yml","event":"pull_request","job":"windows-studio"},
    {"context":"agentic dogfood matrix","workflow":".github/workflows/agentic-dogfood-matrix.yml","event":"pull_request","job":"matrix"},
    {"context":"agent documentation contracts","workflow":".github/workflows/ci.yml","event":"pull_request","job":"agent-contracts"},
    {"context":"build-packages","workflow":".github/workflows/linux-packages.yml","event":"pull_request","job":"build-packages"},
    {"context":"canonical MVP examples","workflow":".github/workflows/ci.yml","event":"pull_request","job":"canonical-examples"},
    {"context":"cargo audit","workflow":".github/workflows/security.yml","event":"pull_request","job":"cargo-audit"},
    {"context":"cargo fuzz run parse_input","workflow":".github/workflows/fuzz-nightly.yml","event":"pull_request","job":"fuzz"},
    {"context":"cargo doc","workflow":".github/workflows/ci.yml","event":"pull_request","job":"docs"},
    {"context":"cargo test (macos-latest)","workflow":".github/workflows/ci.yml","event":"pull_request","job":"test","matrix":{"os":"macos-latest"}},
    {"context":"cargo test (ubuntu-latest)","workflow":".github/workflows/ci.yml","event":"pull_request","job":"test","matrix":{"os":"ubuntu-latest"}},
    {"context":"cargo test (windows-latest)","workflow":".github/workflows/ci.yml","event":"pull_request","job":"test","matrix":{"os":"windows-latest"}},
    {"context":"cargo-deny check","workflow":".github/workflows/security.yml","event":"pull_request","job":"cargo-deny"},
    {"context":"clippy (-D warnings)","workflow":".github/workflows/ci.yml","event":"pull_request","job":"clippy"},
    {"context":"machine-truth drift guard","workflow":".github/workflows/ci.yml","event":"pull_request","job":"truth-check"},
    {"context":"macOS Studio build + test","workflow":".github/workflows/macos-studio.yml","event":"pull_request","job":"macos-studio"},
    {"context":"macos-cli-tarballs (aarch64-apple-darwin)","workflow":".github/workflows/linux-packages.yml","event":"pull_request","job":"macos-cli-tarballs","matrix":{"target":"aarch64-apple-darwin"}},
    {"context":"macos-cli-tarballs (x86_64-apple-darwin)","workflow":".github/workflows/linux-packages.yml","event":"pull_request","job":"macos-cli-tarballs","matrix":{"target":"x86_64-apple-darwin"}},
    {"context":"rustfmt","workflow":".github/workflows/ci.yml","event":"pull_request","job":"fmt"},
    {"context":"shellcheck-installer","workflow":".github/workflows/linux-packages.yml","event":"pull_request","job":"shellcheck-installer"},
    {"context":"smoke-deb","workflow":".github/workflows/linux-packages.yml","event":"pull_request","job":"smoke-deb"},
    {"context":"smoke-rpm","workflow":".github/workflows/linux-packages.yml","event":"pull_request","job":"smoke-rpm"},
    {"context":"Base-controlled trust policy","workflow":".github/workflows/base-controlled-trust.yml","event":"pull_request_target","job":"policy"}
  ]
}
