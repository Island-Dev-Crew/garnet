# Garnet program service unit.
#
# The .deb and .rpm packages install this unit disabled. It runs one Garnet
# program, /etc/garnet/entry.garnet, and starts only if that file matches the
# signed deterministic manifest beside it. To use it, as root:
#
#   mkdir -p /etc/garnet
#   cp my_program.garnet /etc/garnet/entry.garnet
#   garnet keygen /root/garnet-signing.key
#   garnet build --deterministic --sign /root/garnet-signing.key /etc/garnet/entry.garnet
#   systemctl enable --now garnet-actor
#
# ExecStartPre proves that entry.garnet matches entry.garnet.manifest.json
# and that the manifest carries a valid Ed25519 signature. It does not pin
# which key signed it, so keep /etc/garnet writable by root only. Inside the
# program only @caps and @max_depth are enforced; the settings below are the
# OS-level limits.

[Unit]
Description=Garnet program service (/etc/garnet/entry.garnet)
Documentation=man:garnet(1)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/garnet/entry.garnet

[Service]
Type=simple
# A transient user with a private, writable state directory, where garnet
# keeps its machine key and run cache.
DynamicUser=yes
StateDirectory=garnet
WorkingDirectory=/var/lib/garnet
Environment=GARNET_MACHINE_KEY_PATH=/var/lib/garnet/machine.key
ExecStartPre=/usr/bin/garnet verify /etc/garnet/entry.garnet /etc/garnet/entry.garnet.manifest.json --signature
ExecStart=/usr/bin/garnet run /etc/garnet/entry.garnet
Restart=on-failure
RestartSec=5s

# Hardening.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
# A generic allow-list, not derived from the program's @caps; `garnet sandbox`
# prints the policy those imply.
SystemCallFilter=@system-service
SystemCallFilter=~@mount @cpu-emulation @debug @module @obsolete @privileged @raw-io @reboot @swap

# Resource limits.
LimitNOFILE=65536
TasksMax=4096

[Install]
WantedBy=multi-user.target
