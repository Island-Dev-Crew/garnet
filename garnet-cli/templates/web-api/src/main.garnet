# {{name}} — a Garnet HTTP/1.1 service scaffold.
#
# serve_forever below is a placeholder: nothing listens on a port until
# you write the listener. @caps(net, time) is the budget declared for
# that service. net authority covers outbound connections to public
# addresses; add fs or proc only if the service needs them.

@caps(net, time)
def main() {
  let port = 8080
  println("#{timestamp()} starting {{name}} on :#{port}")

  # net::tcp_listen is not bridged into the runtime yet, so this
  # template stops at the @caps discipline and a placeholder loop.
  serve_forever(port)
}

@caps(time)
def timestamp() {
  # wall_clock_ms() requires @caps(time); this function declares it
  # so main can call it without escalating its own cap set.
  let ms = wall_clock_ms()
  "[#{ms}ms]"
}

@caps(net, time)
def serve_forever(port) {
  # Placeholder listener loop: wire your handlers here. Handle each
  # request in a @caps(net) function; avoid promoting a handler to
  # @caps(fs) without explicit need.
  println("(listener loop placeholder — wire your handlers here)")
  0
}
