# Starter tests for {{name}}.

def test_actor_orchestration_pipeline_runs() {
  assert_eq(orchestrate(3), 25)
}

def test_bounded_mailbox_backpressure() {
  let reviewer = Reviewer.spawn(1)
  let first = reviewer.try_tell(:review, 12)
  let second = reviewer.try_tell(:review, 13)
  assert(first)
  assert(not second)
  assert_eq(reviewer.mailbox_size(), 1)
  assert_eq(reviewer.drain(), 1)
  assert_eq(reviewer.ask(:accepted_count), 1)
}

def test_blake3_fact_fingerprint() {
  # Crypto primitive is bridged (v3.4.1 Day 1). Useful for the
  # ManifestSig-style fingerprinting agents do on episodic-store
  # entries before persistence.
  let h = blake3("episode payload")
  assert_eq(len(h), 64)  # 32 bytes hex-encoded
}
